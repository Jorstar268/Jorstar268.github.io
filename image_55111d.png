-tns-c1361134428-100 ng-star-inserted"><div _ngcontent-ng-c1361134428="" class="response-container-header-controls ng-tns-c1361134428-100"><!----><!----></div><!----><!----><div _ngcontent-ng-c1361134428="" class="response-container-header-status ng-tns-c1361134428-100"><!----><div _ngcontent-ng-c1361134428="" class="response-container-header-processing-state ng-tns-c1361134428-100"></div></div></div><!----><div _ngcontent-ng-c1361134428="" class="presented-response-container ng-tns-c1361134428-100" jslog="283401;track:impression,attention" data-hveid="2"><!----><div _ngcontent-ng-c1361134428="" class="response-container-content ng-tns-c1361134428-100"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c1028177799="" highlighttoaskhost="" class="response-content ng-tns-c1361134428-100"><!----><!----><thinking-overlay _ngcontent-ng-c1028177799="" _nghost-ng-c2236698117="" class="enable-luminous-fast-follows ng-star-inserted"><!----></thinking-overlay><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><div _ngcontent-ng-c1028177799="" class="model-response-label-announcer" aria-busy="false" aria-live="polite"><!----><!----><h6 _ngcontent-ng-c1028177799="" class="cdk-visually-hidden screen-reader-model-response-label ng-star-inserted"> Gemini said </h6><!----><!----></div><!----><model-response-content _ngcontent-ng-c1028177799="" _nghost-ng-c39557751=""><div _ngcontent-ng-c39557751="" collapsibleresponsecontent="" class="collapsible-content-wrapper"><!----><structured-content-container _ngcontent-ng-c39557751="" class="model-response-text processing-state-visible ng-star-inserted" _nghost-ng-c1506435711="" style="height: auto;"><div _ngcontent-ng-c1506435711="" class="container"><message-content _ngcontent-ng-c1506435711="" _nghost-ng-c1845261516="" id="message-content-id-r_0cb7730120025d0f" class="ng-star-inserted"><div _ngcontent-ng-c1845261516="" inline-copy-host="" class="markdown markdown-main-panel md-content enable-luminous-fast-follows enable-updated-hr-color stronger" id="model-response-message-contentr_0cb7730120025d0f" aria-busy="false" aria-live="polite" dir="ltr" style="--animation-duration: 400ms; --fade-animation-function: ease-out;"><p dir="ltr" data-path-to-node="0" class="first-token" id="p-rc_5d9d8ae98e9df703-22"><span data-path-to-node="0,0" class="">Tout à fait — sur <code data-path-to-node="0,0" data-index-in-node="18">image_03c53e.jpg</code>, la 3D tourne bien, mais les formes géométriques de base (cubes et cylindres) font trop « prototypes »</span><span data-path-to-node="0,1" class=""><span><response-element class="no-md" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><source-footnote _nghost-ng-c4232265101="" class="ng-star-inserted"><sup _ngcontent-ng-c4232265101="" class="superscript"><!----></sup></source-footnote><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element></span></span><span data-path-to-node="0,2">. Passer à de vrais modèles 3D au format <b data-path-to-node="0,2" data-index-in-node="41"><code data-path-to-node="0,2" data-index-in-node="41">.glb</code> (glTF binaire)</b> donnera tout de suite un rendu réaliste avec des textures détaillées, des gants/mains sculptés et de vraies armes (barillet, crosse, viseur, etc.).</span><sources-carousel-inline ng-version="0.0.0-PLACEHOLDER" _nghost-ng-c775793796="">   <!----><source-inline-chip _ngcontent-ng-c775793796="" _nghost-ng-c2683803803="" class="ng-star-inserted"><div _ngcontent-ng-c2683803803="" class="source-inline-chip-container luminous-sources hide-from-message-actions ng-star-inserted"><button _ngcontent-ng-c2683803803="" cdkoverlayorigin="" class="button multiple-button ng-star-inserted" aria-label="View source details for citation from JPG: image_03c53e.jpg. Press Enter to open sources dialog." aria-expanded="false" aria-haspopup="dialog" jslog="262206;track:generic_click,impression,attention" data-hveid="0" decode-data-ved="1" data-ved="0CAAQvoAQahgKEwj-nfCQlZiYAxUAAAAAHQAAAAAQlQk" id="ow23" __is_owner="true"><!----><div _ngcontent-ng-c2683803803="" dir="auto" class="source-label-container gds-body-s ng-star-inserted"><!----><span _ngcontent-ng-c2683803803="" class="source-title" style="max-width: 20ch;">image_03c53e.jpg</span><!----></div><!----><!----><!----><!----></button><!----><!----><!----><!----></div><!----><!----><!----><!----><!----></source-inline-chip><!----><!----><!----></sources-carousel-inline></p><h3 dir="ltr" data-path-to-node="1">Comment intégrer de vrais modèles 3D <code data-path-to-node="1" data-index-in-node="37">.glb</code> dans votre jeu</h3><ol start="1" dir="ltr" data-path-to-node="2" class="md-has-block-component"><li><p dir="ltr" data-path-to-node="2,0,0"><b data-path-to-node="2,0,0" data-index-in-node="0">Où récupérer des modèles <code data-path-to-node="2,0,0" data-index-in-node="25">.glb</code> gratuits</b></p><ul dir="ltr" data-path-to-node="2,0,1"><li><p dir="ltr" data-path-to-node="2,0,1,0,0"><b data-path-to-node="2,0,1,0,0" data-index-in-node="0">Poly Pizza</b><span> ou </span><b data-path-to-node="2,0,1,0,0" data-index-in-node="14">Quaternius</b><span> :</span><span> packs d'armes et de mains FPS gratuits (CC0,</span><span> sans compte requis) déjà prêts au format </span><code data-path-to-node="2,0,1,0,0" data-index-in-node="113">.glb</code><span>.</span></p></li><li><p dir="ltr" data-path-to-node="2,0,1,1,0"><b data-path-to-node="2,0,1,1,0" data-index-in-node="0">Sketchfab</b><span> :</span><span> filtrez par </span><i data-path-to-node="2,0,1,1,0" data-index-in-node="24">Downloadable</i><span> + </span><i data-path-to-node="2,0,1,1,0" data-index-in-node="39">Free</i><span> et téléchargez au format </span><b data-path-to-node="2,0,1,1,0" data-index-in-node="69">glTF / <code data-path-to-node="2,0,1,1,0" data-index-in-node="76">.glb</code></b><span> (par exemple :</span><span> </span><i data-path-to-node="2,0,1,1,0" data-index-in-node="96">"FPS hands"</i><span>,</span><span> </span><i data-path-to-node="2,0,1,1,0" data-index-in-node="109">"Revolver .357"</i><span>,</span><span> </span><i data-path-to-node="2,0,1,1,0" data-index-in-node="126">"Shotgun"</i><span>,</span><span> </span><i data-path-to-node="2,0,1,1,0" data-index-in-node="137">"Assault Rifle"</i><span>).</span></p></li><li><p dir="ltr" data-path-to-node="2,0,1,2,0"><span>Placez vos fichiers téléchargés dans un dossier </span><code data-path-to-node="2,0,1,2,0" data-index-in-node="48">models/</code><span> à côté de </span><code data-path-to-node="2,0,1,2,0" data-index-in-node="66">index.html</code><span> (ex.</span><span> </span><code data-path-to-node="2,0,1,2,0" data-index-in-node="82">models/hands.glb</code><span>,</span><span> </span><code data-path-to-node="2,0,1,2,0" data-index-in-node="100">models/revolver.glb</code><span>,</span><span> </span><code data-path-to-node="2,0,1,2,0" data-index-in-node="121">models/pistol.glb</code><span>,</span><span> etc.</span><span>).</span></p></li></ul></li><li><p dir="ltr" data-path-to-node="2,1,0"><b data-path-to-node="2,1,0" data-index-in-node="0">Ajouter le chargeur <code data-path-to-node="2,1,0" data-index-in-node="20">GLTFLoader</code> dans <code data-path-to-node="2,1,0" data-index-in-node="36">index.html</code></b><span>
Juste après </span><code data-path-to-node="2,1,0" data-index-in-node="59">three.min.js</code><span> et avant </span><code data-path-to-node="2,1,0" data-index-in-node="81">script.js</code><span>,</span><span> ajoutez :</span></p><response-element class="no-md" ng-version="0.0.0-PLACEHOLDER"><!----><!----><!----><!----><!----><!----><code-block _nghost-ng-c2260553123="" class="ng-tns-c2260553123-101 enable-luminous-code-block ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2260553123="" class="code-block ng-tns-c2260553123-101 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:W1sicl8wY2I3NzMwMTIwMDI1ZDBmIiwiY18xNjNhNjhlNzE2NWIxMDY2IixudWxsLCJyY181ZDlkOGFlOThlOWRmNzAzIixudWxsLG51bGwsImZyIixudWxsLDEsbnVsbCxudWxsLDAsMF1d" style="display: block;" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwj-nfCQlZiYAxUAAAAAHQAAAAAQjgk"><!----><div _ngcontent-ng-c2260553123="" class="formatted-code-block-internal-container ng-tns-c2260553123-101"><div _ngcontent-ng-c2260553123="" class="animated-opacity ng-tns-c2260553123-101"><div _ngcontent-ng-c2260553123="" class="code-block-decoration header-formatted gds-emphasized-body-m ng-tns-c2260553123-101 ng-star-inserted" style=""><span _ngcontent-ng-c2260553123="" class="ng-tns-c2260553123-101">HTML</span><div _ngcontent-ng-c2260553123="" class="buttons ng-tns-c2260553123-101 ng-star-inserted"><gem-icon-button _ngcontent-ng-c2260553123="" type="onSurface" size="small" fonticonname="arrow_circle_down" theme="lm" arialabel="Download code" gemtooltip="Download code" class="mat-mdc-tooltip-trigger download-button ng-tns-c2260553123-101 gem-button gem-button-badge-size-small gem-button-size-small gem-button-type-on-surface lm-enabled ng-star-inserted" _nghost-ng-c3971949594="" aria-describedby="cdk-describedby-message-ng-1-45" cdk-describedby-host="ng-1"><!----><!----><button _ngcontent-ng-c3971949594="" matbadgeposition="after" maticonbutto