eneric_click,impression;BardVeMetadataKey:W1sicl83NjkzOWI4MjI4MTA0ZjgyIiwiY18xNjNhNjhlNzE2NWIxMDY2IixudWxsLCJyY18xNTBhMGYwYjYwYjFhOWIzIixudWxsLG51bGwsImZyIixudWxsLDEsbnVsbCxudWxsLDEsMF1d;mutable:true" aria-disabled="false"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><gem-icon _ngcontent-ng-c3971949594="" _nghost-ng-c2757884704=""><mat-icon _ngcontent-ng-c2757884704="" role="img" class="mat-icon notranslate lm-icon-l lumi-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="copy" data-mat-icon-namespace="lumi-symbols" fonticon="copy"></mat-icon><!----><!----><!----></gem-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span><span class="mat-ripple mat-mdc-button-ripple"></span></button><!----><!----></gem-icon-button><!----><!----><!----><!----></div><!----><!----></div><!----><pre _ngcontent-ng-c2260553123="" class="ng-tns-c2260553123-48"><code _ngcontent-ng-c2260553123="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2260553123-48"><span class="hljs-keyword">@media</span> (<span class="hljs-attribute">max-width</span>: <span class="hljs-number">768px</span>) {
    <span class="hljs-selector-class">.move-center-stick</span> {
        <span class="hljs-attribute">width</span>: <span class="hljs-number">132px</span>;
        <span class="hljs-attribute">height</span>: <span class="hljs-number">132px</span>;
    }
    <span class="hljs-selector-class">.key-z</span> {
        <span class="hljs-attribute">top</span>: <span class="hljs-built_in">calc</span>(<span class="hljs-number">50%</span> - <span class="hljs-number">56px</span>);
    }
    <span class="hljs-selector-class">.key-s</span> {
        <span class="hljs-attribute">top</span>: <span class="hljs-built_in">calc</span>(<span class="hljs-number">50%</span> + <span class="hljs-number">22px</span>);
    }
    <span class="hljs-selector-class">.key-q</span> {
        <span class="hljs-attribute">left</span>: <span class="hljs-built_in">calc</span>(<span class="hljs-number">50%</span> - <span class="hljs-number">56px</span>);
    }
    <span class="hljs-selector-class">.key-d</span> {
        <span class="hljs-attribute">left</span>: <span class="hljs-built_in">calc</span>(<span class="hljs-number">50%</span> + <span class="hljs-number">22px</span>);
    }
    <span class="hljs-selector-class">.move-key</span> {
        <span class="hljs-attribute">width</span>: <span class="hljs-number">34px</span>;
        <span class="hljs-attribute">height</span>: <span class="hljs-number">34px</span>;
        <span class="hljs-attribute">font-size</span>: <span class="hljs-number">0.88rem</span>;
    }
    <span class="hljs-selector-class">.fps-action-cluster</span> {
        <span class="hljs-attribute">width</span>: <span class="hljs-number">184px</span>;
        <span class="hljs-attribute">height</span>: <span class="hljs-number">184px</span>;
    }
}
</code></pre><!----></div></div></div><!----><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p dir="ltr" data-path-to-node="5"><span>Une fois ces deux points nettoyés,</span><span> le centrage dans le carré bas-gauche et le carré bas-droit fonctionnera proprement.</span></p></div><!----></message-content><!----><!----></div></structured-content-container><!----><!----></div><!----><!----></model-response-content><!----><!----><!----><!----><div _ngcontent-ng-c1028177799="" class="response-footer gap complete"><!----><!----><!----><sources-list _ngcontent-ng-c1028177799="" class="sources-list ng-star-inserted"><!----></sources-list><!----><!----><election-info-disclaimer _ngcontent-ng-c1028177799="" _nghost-ng-c3304081241="" class="ng-star-inserted" style="display: none;"><!----></election-info-disclaimer><finance-info-disclaimer _ngcontent-ng-c1028177799="" _nghost-ng-c2433247864="" class="ng-star-inserted" style="display: none;"><!----></finance-info-disclaimer><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><!----><sensitive-memories-banner _ngcontent-ng-c1028177799="" _nghost-ng-c861928794="" class="ng-star-inserted"><!----></sensitive-memories-banner><!----><!----><!----><!----><!----><!----></div></div><div _ngcontent-ng-c1361134428="" class="response-container-footer ng-tns-c1361134428-47 ng-star