];

<span class="hljs-keyword">const</span> difficulties = [
    { <span class="hljs-attr">level</span>: <span class="hljs-number">1</span>, <span class="hljs-attr">name</span>: <span class="hljs-string">"Débutant"</span>, <span class="hljs-attr">rewardMult</span>: <span class="hljs-string">"Récompense x1.0"</span> },
    { <span class="hljs-attr">level</span>: <span class="hljs-number">2</span>, <span class="hljs-attr">name</span>: <span class="hljs-string">"Survivant"</span>, <span class="hljs-attr">rewardMult</span>: <span class="hljs-string">"Récompense x1.3"</span> },
    { <span class="hljs-attr">level</span>: <span class="hljs-number">3</span>, <span class="hljs-attr">name</span>: <span class="hljs-string">"Vétéran"</span>, <span class="hljs-attr">rewardMult</span>: <span class="hljs-string">"Récompense x1.7"</span> },
    { <span class="hljs-attr">level</span>: <span class="hljs-number">4</span>, <span class="hljs-attr">name</span>: <span class="hljs-string">"Cauchemar"</span>, <span class="hljs-attr">rewardMult</span>: <span class="hljs-string">"Récompense x2.2"</span> },
    { <span class="hljs-attr">level</span>: <span class="hljs-number">5</span>, <span class="hljs-attr">name</span>: <span class="hljs-string">"Enfer Absolu"</span>, <span class="hljs-attr">rewardMult</span>: <span class="hljs-string">"Récompense x3.0"</span> }
];

<span class="hljs-keyword">let</span> equippedWeaponId = <span class="hljs-string">"barre_fer"</span>;
<span class="hljs-keyword">let</span> selectedUpgradeWeaponId = <span class="hljs-string">"barre_fer"</span>;

<span class="hljs-keyword">const</span> moneyDisplay = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"player-money"</span>);
<span class="hljs-keyword">const</span> shopMoneyDisplay = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"shop-money"</span>);
<span class="hljs-keyword">const</span> upgradeMoneyDisplay = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"upgrade-money"</span>);
<span class="hljs-keyword">const</span> panelShop = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"panel-shop"</span>);
<span class="hljs-keyword">const</span> panelUpgrade = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"panel-upgrade"</span>);
<span class="hljs-keyword">const</span> difficultyScreen = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"difficulty-screen"</span>);

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">updateMoneyUI</span>(<span class="hljs-params"></span>) </span>{
    moneyDisplay.textContent = money;
    shopMoneyDisplay.textContent = money;
    upgradeMoneyDisplay.textContent = money;
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">getStatsAtLevel</span>(<span class="hljs-params">weapon, level</span>) </span>{
    <span class="hljs-keyword">const</span> diff = level - <span class="hljs-number">1</span>;
    <span class="hljs-keyword">const</span> reloadTime = <span class="hljs-built_in">Math</span>.max(<span class="hljs-number">0.15</span>, +(weapon.stats.reloadTime + diff * weapon.step.reloadTime).toFixed(<span class="hljs-number">2</span>));
    <span class="hljs-keyword">const</span> fireRate = +(weapon.stats.fireRate + diff * weapon.step.fireRate).toFixed(<span class="hljs-number">2</span>);
    <span class="hljs-keyword">return</span> {
        <span class="hljs-attr">ammo</span>: <span class="hljs-built_in">Math</span>.round(weapon.stats.ammo + diff * weapon.step.ammo),
        reloadTime,
        fireRate,
        <span class="hljs-attr">dmgClose</span>: <span class="hljs-built_in">Math</span>.round(weapon.stats.dmgClose + diff * weapon.step.dmgClose),
        <span class="hljs-attr">dmgMid</span>: <span class="hljs-built_in">Math</span>.round(weapon.stats.dmgMid + diff * weapon.step.dmgMid),
        <span class="hljs-attr">dmgFar</span>: <span class="hljs-built_in">Math</span>.round(weapon.stats.dmgFar + diff * weapon.step.dmgFar)
    };
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">formatRangeDamage</span>(<span class="hljs-params">s</span>) </span>{
    <span class="hljs-keyword">return</span> <span class="hljs-string">`Proche <span class="hljs-subst">${s.dmgClose}</span> / Moy. <span class="hljs-subst">${s.dmgMid}</span> / Loin <span class="hljs-subst">${s.dmgFar}</span>`</span>;
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">renderStatsRows</span>(<span class="hljs-params">s</span>) </span>{
    <span class="hljs-keyword">return</span> <span class="hljs-string">`
        &lt;div class="stat-row"&gt;&lt;span class="stat-label"&gt;Munitions&lt;/span&gt;&lt;span class="stat-val"&gt;<span class="hljs-subst">${s.ammo}</span>&lt;/span&gt;&lt;/div&gt;
        &lt;div class="stat-row"&gt;&lt;span class="stat-label"&gt;Temps rechargement&lt;/span&gt;&lt;span class="stat-val"&gt;<span class="hljs-subst">${s.reloadTime}</span> s&lt;/span&gt;&lt;/div&gt;
        &lt;div class="stat-row"&gt;&lt;span class="stat-label"&gt;Vitesse de tir&lt;/span&gt;&lt;span class="stat-val"&gt;<span class="hljs-subst">${s.fireRate}</span> /s&lt;/span&gt;&lt;/div&gt;
        &lt;div class="stat-row"&gt;&lt;span class="stat-label"&gt;Dégâts / distance&lt;/span&gt;&lt;span class="stat-val"&gt;<span class="hljs-subst">${formatRangeDamage(s)}</span>&lt;/span&gt;&lt;/div&gt;
    `</span>;
}

<span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"btn-shop"</span>).addEventListener(<span class="hljs-string">"click"</span>, <span class="hljs-function">() =&gt;</span> {
    panelUpgrade.classList.add(<span class="hljs-string">"hidden"</span>);
    panelShop.classList.toggle(<span class="hljs-string">"hidden"</span>);
    updateMoneyUI();
    renderShop();
});

<span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"btn-upgrade"</span>).addEventListener(<span class="hljs-string">"click"</span>, <span class="hljs-function">() =&gt;</span> {
    panelShop.classList.add(<span class="hljs-string">"hidden"</span>);
    panelUpgrade.classList.toggle(<span class="hljs-string">"hidden"</span>);
    updateMoneyUI();
    renderUpgrades();
});

<span class="hljs-built_in">document</span>.querySelectorAll(<span class="hljs-string">".close-btn"</span>).forEach(<span class="hljs-function"><span class="hljs-params">btn</span> =&gt;</span> {
    btn.addEventListener(<span class="hljs-string">"click"</span>, <span class="hljs-function">() =&gt;</span> {
        <span class="hljs-built_in">document</span>.getElementById(btn.dataset.close).classList.add(<span class="hljs-string">"hidden"</span>);
    });
});

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">renderShop</span>(<span class="hljs-params"></span>) </span>{
    updateMoneyUI();
    <span class="hljs-keyword">const</span> shopList = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"shop-list"</span>);
    shopList.innerHTML = <span class="hljs-string">""</span>;

    weapons.forEach(<span class="hljs-function"><span class="hljs-params">w</span> =&gt;</span> {
        <span class="hljs-keyword">const</span> s = getStatsAtLevel(w, w.level);
        <span class="hljs-keyword">const</span> card = <span class="hljs-built_in">document</span>.createElement(<span class="hljs-string">"div"</span>);
        card.className = <span class="hljs-string">"weapon-box-card"</span>;

        <span class="hljs-keyword">let</span> actionHtml = <span class="hljs-string">""</span>;
        <span class="hljs-keyword">if</span> (w.owned) {
            <span class="hljs-keyword">const</span> isEquipped = equippedWeaponId === w.id;
            actionHtml = <span class="hljs-string">`
                &lt;button class="action-btn" onclick="equipWeapon('<span class="hljs-subst">${w.id}</span>')" <span class="hljs-subst">${isEquipped ? <span class="hljs-string">"disabled"</span> : <span class="hljs-string">""</span>}</span>&gt;
                    <span class="hljs-subst">${isEquipped ? <span class="hljs-string">"ÉQUIPÉE"</span> : <span class="hljs-string">"ÉQUIPER"</span>}</span>
                &lt;/button&gt;
            `</span>;
        } <span class="hljs-keyword">else</span> {
            <span class="hljs-keyword">const</span> canAfford = money &gt;= w.price;
            actionHtml = <span class="hljs-string">`
                &lt;button class="action-btn" onclick="buyWeapon('<span class="hljs-subst">${w.id}</span>')" <span class="hljs-subst">${!canAfford ? <span class="hljs-string">"disabled"</span> : <span class="hljs-string">""</span>}</span>&gt;
                    Acheter
                &lt;/button&gt;
            `</span>;
        }

        <span class="hljs-keyword">const</span> priceText = w.owned ? <span class="hljs-string">`Possédée (Niv. <span class="hljs-subst">${w.level}</span>)`</span> : <span class="hljs-string">`Prix : <span class="hljs-subst">${w.price}</span> $`</span>;

        card.innerHTML = <span class="hljs-string">`
            &lt;div class="weapon-left-box"&gt;
                &lt;h3 class="weapon-name"&gt;<span class="hljs-subst">${w.name}</span>&lt;/h3&gt;
                &lt;div class="weapon-img-wrap"&gt;
                    &lt;img src="<span class="hljs-subst">${w.image}</span>" alt="<span class="hljs-subst">${w.name}</span>"&gt;
                &lt;/div&gt;
                &lt;div class="weapon-bottom-footer"&gt;
                    &lt;span class="weapon-price-tag"&gt;<span class="hljs-subst">${priceText}</span>&lt;/span&gt;
                    <span class="hljs-subst">${actionHtml}</span>
                &lt;/div&gt;
            &lt;/div&gt;
            &lt;div class="weapon-right-stats"&gt;
                <span class="hljs-subst">${renderStatsRows(s)}</span>
            &lt;/div&gt;
        `</span>;
        shopList.appendChild(card);
    });
}

<span class="hljs-built_in">window</span>.buyWeapon = <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params">id</span>) </span>{
    <span class="hljs-keyword">const</span> weapon = weapons.find(<span class="hljs-function"><span class="hljs-params">w</span> =&gt;</span> w.id === id);
    <span class="hljs-keyword">if</span> (weapon &amp;&amp; !weapon.owned &amp;&amp; money &gt;= weapon.price) {
        money -= weapon.price;
        weapon.owned = <span class="hljs-literal">true</span>;
        equippedWeaponId = weapon.id;
        updateMoneyUI();
        renderShop();
    }
};

<span class="hljs-built_in">window</span>.equipWeapon = <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params">id</span>) </span>{
    <span class="hljs-keyword">const</span> weapon = weapons.find(<span class="hljs-function"><span class="hljs-params">w</span> =&gt;</span> w.id === id);
    <span class="hljs-keyword">if</span> (weapon &amp;&amp; weapon.owned) {
        equippedWeaponId = weapon.id;
        renderShop();
    }
};

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">renderUpgrades</span>(<span class="hljs-params"></span>) </span>{
    updateMoneyUI();
    <span class="hljs-keyword">const</span> upgradeList = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"upgrade-list"</span>);
    <span class="hljs-keyword">const</span> placeholder = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"compare-placeholder"</span>);
    <span class="hljs-keyword">const</span> compareBoxes = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"compare-boxes"</span>);

    upgradeList.innerHTML = <span class="hljs-string">""</span>;
    <span class="hljs-keyword">const</span> ownedWeapons = weapons.filter(<span class="hljs-function"><span class="hljs-params">w</span> =&gt;</span> w.owned);

    <span class="hljs-keyword">if</span> (ownedWeapons.length === <span class="hljs-number">0</span>) {
        upgradeList.innerHTML = <span class="hljs-string">`&lt;p class="empty-msg"&gt;Vous ne possédez aucune arme à améliorer.&lt;/p&gt;`</span>;
        compareBoxes.classList.add(<span class="hljs-string">"hidden"</span>);
        placeholder.classList.remove(<span class="hljs-string">"hidden"</span>);
        <span class="hljs-keyword">return</span>;
    }

    <span class="hljs-keyword">if</span> (!ownedWeapons.some(<span class="hljs-function"><span class="hljs-params">w</span> =&gt;</span> w.id === selectedUpgradeWeaponId)) {
        selectedUpgradeWeaponId = ownedWeapons[<span class="hljs-number">0</span>].id;
    }

    ownedWeapons.forEach(<span class="hljs-function"><span class="hljs-params">w</span> =&gt;</span> {
        <span class="hljs-keyword">const</span> s = getStatsAtLevel(w, w.level);
        <span class="hljs-keyword">const</span> isSelected = w.id === selectedUpgradeWeaponId;

        <span class="hljs-keyword">const</span> card = <span class="hljs-built_in">document</span>.createElement(<span class="hljs-string">"div"</span>);
        card.className = <span class="hljs-string">`weapon-box-card selectable <span class="hljs-subst">${isSelected ? <span class="hljs-string">"selected"</span> : <span class="hljs-string">""</span>}</span>`</span>;
        card.innerHTML = <span class="hljs-string">`
            &lt;div class="weapon-left-box"&gt;
                &lt;h3 class="weapon-name"&gt;<span class="hljs-subst">${w.name}</span> (Niv. <span class="hljs-subst">${w.level}</span>/<span class="hljs-subst">${w.maxLevel}</span>)&lt;/h3&gt;
                &lt;div class="weapon-img-wrap"&gt;
                    &lt;img src="<span class="hljs-subst">${w.image}</span>" alt="<span class="hljs-subst">${w.name}</span>"&gt;
                &lt;/div&gt;
            &lt;/div&gt;
            &lt;div class="weapon-right-stats"&gt;
                <span class="hljs-subst">${renderStatsRows(s)}</span>
            &lt;/div&gt;
        `</span>;
        card.addEventListener(<span class="hljs-string">"click"</span>, <span class="hljs-function">() =&gt;</span> {
            selectedUpgradeWeaponId = w.id;
            renderUpgrades();
        });
        upgradeList.appendChild(card);
    });

    renderUpgradeComparison(selectedUpgradeWeaponId);
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">renderUpgradeComparison</span>(<span class="hljs-params">id</span>) </span>{
    <span class="hljs-keyword">const</span> placeholder = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"compare-placeholder"</span>);
    <span class="hljs-keyword">const</span> compareBoxes = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"compare-boxes"</span>);
    <span class="hljs-keyword">const</span> weapon = weapons.find(<span class="hljs-function"><span class="hljs-params">w</span> =&gt;</span> w.id === id &amp;&amp; w.owned);

    <span class="hljs-keyword">if</span> (!weapon) {
        compareBoxes.classList.add(<span class="hljs-string">"hidden"</span>);
        placeholder.classList.remove(<span class="hljs-string">"hidden"</span>);
        <span class="hljs-keyword">return</span>;
    }

    placeholder.classList.add(<span class="hljs-string">"hidden"</span>);
    compareBoxes.classList.remove(<span class="hljs-string">"hidden"</span>);

    <span class="hljs-keyword">const</span> currentStats = getStatsAtLevel(weapon, weapon.level);
    <span class="hljs-keyword">const</span> isMax = weapon.level &gt;= weapon.maxLevel;
    <span class="hljs-keyword">const</span> nextLevel = isMax ? weapon.maxLevel : weapon.level + <span class="hljs-number">1</span>;
    <span class="hljs-keyword">const</span> nextStats = getStatsAtLevel(weapon, nextLevel);

    <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"compare-current-name"</span>).textContent = <span class="hljs-string">`<span class="hljs-subst">${weapon.name}</span> — Niv. <span class="hljs-subst">${weapon.level}</span>`</span>;
    <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"compare-current-stats"</span>).innerHTML = <span class="hljs-string">`
        &lt;div class="compare-stat-item"&gt;&lt;span&gt;Munitions&lt;/span&gt;&lt;strong&gt;<span class="hljs-subst">${currentStats.ammo}</span>&lt;/strong&gt;&lt;/div&gt;
        &lt;div class="compare-stat-item"&gt;&lt;span&gt;Temps de rechargement&lt;/span&gt;&lt;strong&gt;<span class="hljs-subst">${currentStats.reloadTime}</span> s&lt;/strong&gt;&lt;/div&gt;
        &lt;div class="compare-stat-item"&gt;&lt;span&gt;Vitesse de tir&lt;/span&gt;&lt;strong&gt;<span class="hljs-subst">${currentStats.fireRate}</span> /s&lt;/strong&gt;&lt;/div&gt;
        &lt;div class="compare-stat-item"&gt;&lt;span&gt;Dégâts par distance&lt;/span&gt;&lt;strong&gt;<span class="hljs-subst">${formatRangeDamage(currentStats)}</span>&lt;/strong&gt;&lt;/div&gt;
    `</span>;

    <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"compare-next-name"</span>).textContent = isMax
        ? <span class="hljs-string">`<span class="hljs-subst">${weapon.name}</span> — NIVEAU MAX`</span>
        : <span class="hljs-string">`<span class="hljs-subst">${weapon.name}</span> — Niv. <span class="hljs-subst">${nextLevel}</span>`</span>;

    <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"compare-next-stats"</span>).innerHTML = <span class="hljs-string">`
        &lt;div class="compare-stat-item"&gt;&lt;span&gt;Munitions&lt;/span&gt;&lt;strong&gt;<span class="hljs-subst">${nextStats.ammo}</span>&lt;/strong&gt;&lt;/div&gt;
        &lt;div class="compare-stat-item"&gt;&lt;span&gt;Temps de rechargement&lt;/span&gt;&lt;strong&gt;<span class="hljs-subst">${nextStats.reloadTime}</span> s&lt;/strong&gt;&lt;/div&gt;
        &lt;div class="compare-stat-item"&gt;&lt;span&gt;Vitesse de tir&lt;/span&gt;&lt;strong&gt;<span class="hljs-subst">${nextStats.fireRate}</span> /s&lt;/strong&gt;&lt;/div&gt;
        &lt;div class="compare-stat-item"&gt;&lt;span&gt;Dégâts par distance&lt;/span&gt;&lt;strong&gt;<span class="hljs-subst">${formatRangeDamage(nextStats)}</span>&lt;/strong&gt;&lt;/div&gt;
    `</span>;

    <span class="hljs-keyword">const</span> canUpgrade = !isMax &amp;&amp; money &gt;= weapon.upgradeCost;
    <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"compare-action-area"</span>).innerHTML = <span class="hljs-string">`
        &lt;button class="action-btn" onclick="upgradeWeapon('<span class="hljs-subst">${weapon.id}</span>')" <span class="hljs-subst">${!canUpgrade ? <span class="hljs-string">"disabled"</span> : <span class="hljs-string">""</span>}</span>&gt;
            <span class="hljs-subst">${isMax ? <span class="hljs-string">"NIVEAU MAX"</span> : <span class="hljs-string">`Améliorer (<span class="hljs-subst">${weapon.upgradeCost}</span> $)`</span>}</span>
        &lt;/button&gt;
    `</span>;
}

<span class="hljs-built_in">window</span>.upgradeWeapon = <span class="hljs-function"><span class="hljs-keyword">function</span>(<span class="hljs-params">id</span>) </span>{
    <span class="hljs-keyword">const</span> weapon = weapons.find(<span class="hljs-function"><span class="hljs-params">w</span> =&gt;</span> w.id === id);
    <span class="hljs-keyword">if</span> (weapon &amp;&amp; weapon.owned &amp;&amp; weapon.level &lt; weapon.maxLevel &amp;&amp; money &gt;= weapon.upgradeCost) {
        money -= weapon.upgradeCost;
        weapon.level++;
        weapon.upgradeCost = <span class="hljs-built_in">Math</span>.round(weapon.upgradeCost * <span class="hljs-number">1.5</span>);
        updateMoneyUI();
        renderUpgrades();
    }
};

<span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"btn-play"</span>).addEventListener(<span class="hljs-string">"click"</span>, <span class="hljs-function">() =&gt;</span> {
    panelShop.classList.add(<span class="hljs-string">"hidden"</span>);
    panelUpgrade.classList.add(<span class="hljs-string">"hidden"</span>);

    <span class="hljs-keyword">const</span> equipped = weapons.find(<span class="hljs-function"><span class="hljs-params">w</span> =&gt;</span> w.id === equippedWeaponId);
    <span class="hljs-keyword">const</span> s = getStatsAtLevel(equipped, equipped.level);
    <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"equipped-weapon-info"</span>).textContent =
        <span class="hljs-string">`Arme équipée : <span class="hljs-subst">${equipped.name}</span> (Niv. <span class="hljs-subst">${equipped.level}</span> • Dégâts proche : <span class="hljs-subst">${s.dmgClose}</span>)`</span>;

    renderDifficultyCases();
    difficultyScreen.classList.remove(<span class="hljs-string">"hidden"</span>);
});

<span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"btn-close-diff"</span>).addEventListener(<span class="hljs-string">"click"</span>, <span class="hljs-function">() =&gt;</span> {
    difficultyScreen.classList.add(<span class="hljs-string">"hidden"</span>);
});

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">renderDifficultyCases</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">const</span> grid = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"difficulty-grid"</span>);
    grid.innerHTML = <span class="hljs-string">""</span>;

    difficulties.forEach(<span class="hljs-function"><span class="hljs-params">diff</span> =&gt;</span> {
        <span class="hljs-keyword">const</span> box = <span class="hljs-built_in">document</span>.createElement(<span class="hljs-string">"div"</span>);
        box.className = <span class="hljs-string">"diff-card"</span>;
        box.innerHTML = <span class="hljs-string">`
            &lt;span class="diff-level"&gt;Niveau <span class="hljs-subst">${diff.level}</span>&lt;/span&gt;
            &lt;span class="diff-name"&gt;<span class="hljs-subst">${diff.name}</span>&lt;/span&gt;
            &lt;span class="diff-mult"&gt;<span class="hljs-subst">${diff.rewardMult}</span>&lt;/span&gt;
        `</span>;
        box.addEventListener(<span class="hljs-string">"click"</span>, <span class="hljs-function">() =&gt;</span> {
            difficultyScreen.classList.add(<span class="hljs-string">"hidden"</span>);
            startCombatWithRectangles(diff);
        });
        grid.appendChild(box);
    });
}

<span class="hljs-comment">// =========================================================</span>
<span class="hljs-comment">// --- TRANSITION 20 RECTANGLES ROUGE/VERT &amp; BOUTONS COMBAT ---</span>
<span class="hljs-comment">// =========================================================</span>

<span class="hljs-keyword">const</span> transitionGrid = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"transition-grid"</span>);
<span class="hljs-keyword">const</span> combatScreen = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"combat-screen"</span>);
<span class="hljs-keyword">const</span> combatViewLayer = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"combat-view-layer"</span>);
<span class="hljs-keyword">const</span> crosshair = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"crosshair"</span>);
<span class="hljs-keyword">const</span> armsRig = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"player-arms-weapon"</span>);
<span class="hljs-keyword">const</span> combatWeaponImg = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"combat-weapon-img"</span>);
<span class="hljs-keyword">const</span> combatWeaponLabel = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"combat-weapon-label"</span>);
<span class="hljs-keyword">const</span> combatStatusBadge = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"combat-status-badge"</span>);
<span class="hljs-keyword">const</span> combatEarnedMoneyEl = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"combat-earned-money"</span>);
<span class="hljs-keyword">const</span> healChargesEl = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"heal-charges"</span>);

<span class="hljs-keyword">let</span> inCombat = <span class="hljs-literal">false</span>;
<span class="hljs-keyword">let</span> earnedInMatch = <span class="hljs-number">0</span>;
<span class="hljs-keyword">let</span> healCharges = <span class="hljs-number">3</span>;
<span class="hljs-keyword">let</span> currentWave = <span class="hljs-number">1</span>;
<span class="hljs-keyword">const</span> totalWaves = <span class="hljs-number">5</span>;
<span class="hljs-keyword">let</span> lookYaw = <span class="hljs-number">0</span>;
<span class="hljs-keyword">let</span> lookPitch = <span class="hljs-number">0</span>;
<span class="hljs-keyword">let</span> activeDifficulty = <span class="hljs-literal">null</span>;

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">build20Rectangles</span>(<span class="hljs-params"></span>) </span>{
    transitionGrid.innerHTML = <span class="hljs-string">""</span>;
    <span class="hljs-keyword">const</span> rects = [];
    <span class="hljs-keyword">for</span> (<span class="hljs-keyword">let</span> i = <span class="hljs-number">0</span>; i &lt; <span class="hljs-number">20</span>; i++) {
        <span class="hljs-keyword">const</span> rect = <span class="hljs-built_in">document</span>.createElement(<span class="hljs-string">"div"</span>);
        rect.className = <span class="hljs-string">`transition-rect <span class="hljs-subst">${i % <span class="hljs-number">2</span> === <span class="hljs-number">0</span> ? <span class="hljs-string">"rect-red"</span> : <span class="hljs-string">"rect-green"</span>}</span>`</span>;
        transitionGrid.appendChild(rect);
        rects.push(rect);
    }
    <span class="hljs-keyword">return</span> rects;
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">startCombatWithRectangles</span>(<span class="hljs-params">diff</span>) </span>{
    activeDifficulty = diff;
    earnedInMatch = <span class="hljs-number">0</span>;
    healCharges = <span class="hljs-number">3</span>;
    currentWave = <span class="hljs-number">1</span>;
    lookYaw = <span class="hljs-number">0</span>;
    lookPitch = <span class="hljs-number">0</span>;

    combatEarnedMoneyEl.textContent = earnedInMatch;
    healChargesEl.textContent = healCharges;
    renderWaveSegments(currentWave);
    syncCombatWeaponView();
    updateViewLook();

    <span class="hljs-keyword">const</span> rects = build20Rectangles();
    transitionGrid.classList.remove(<span class="hljs-string">"hidden"</span>);

    <span class="hljs-comment">// Retire un rectangle à la fois : rouge, puis vert, puis rouge, puis vert...</span>
    rects.forEach(<span class="hljs-function">(<span class="hljs-params">rect, index</span>) =&gt;</span> {
        <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">() =&gt;</span> {
            rect.classList.add(<span class="hljs-string">"rect-hidden"</span>);
            <span class="hljs-keyword">if</span> (index === rects.length - <span class="hljs-number">1</span>) {
                <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">() =&gt;</span> {
                    transitionGrid.classList.add(<span class="hljs-string">"hidden"</span>);
                    transitionGrid.innerHTML = <span class="hljs-string">""</span>;
                    combatScreen.classList.remove(<span class="hljs-string">"hidden"</span>);
                    inCombat = <span class="hljs-literal">true</span>;
                    combatStatusBadge.textContent =
                        <span class="hljs-string">`Difficulté <span class="hljs-subst">${diff.level}</span> (<span class="hljs-subst">${diff.name}</span>) — Vague <span class="hljs-subst">${currentWave}</span>/<span class="hljs-subst">${totalWaves}</span>`</span>;
                }, <span class="hljs-number">220</span>);
            }
        }, index * <span class="hljs-number">55</span>);
    });
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">renderWaveSegments</span>(<span class="hljs-params">waveNum</span>) </span>{
    <span class="hljs-keyword">const</span> container = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"wave-segments"</span>);
    container.innerHTML = <span class="hljs-string">""</span>;
    <span class="hljs-keyword">for</span> (<span class="hljs-keyword">let</span> i = <span class="hljs-number">1</span>; i &lt;= totalWaves; i++) {
        <span class="hljs-keyword">const</span> seg = <span class="hljs-built_in">document</span>.createElement(<span class="hljs-string">"div"</span>);
        seg.className = <span class="hljs-string">`wave-seg <span class="hljs-subst">${i &lt;= waveNum ? <span class="hljs-string">"active"</span> : <span class="hljs-string">""</span>}</span>`</span>;
        container.appendChild(seg);
    }
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">syncCombatWeaponView</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">const</span> equipped = weapons.find(<span class="hljs-function"><span class="hljs-params">w</span> =&gt;</span> w.id === equippedWeaponId) || weapons[<span class="hljs-number">0</span>];
    combatWeaponImg.src = equipped.image;
    combatWeaponImg.alt = equipped.name;
    combatWeaponLabel.textContent = <span class="hljs-string">`<span class="hljs-subst">${equipped.name}</span> (Niv. <span class="hljs-subst">${equipped.level}</span>)`</span>;
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">updateViewLook</span>(<span class="hljs-params"></span>) </span>{
    combatViewLayer.style.backgroundPosition = <span class="hljs-string">`<span class="hljs-subst">${<span class="hljs-number">50</span> + lookYaw * <span class="hljs-number">0.25</span>}</span>% <span class="hljs-subst">${<span class="hljs-number">50</span> + lookPitch * <span class="hljs-number">0.25</span>}</span>%`</span>;
    armsRig.style.transform = <span class="hljs-string">`translateX(calc(-50% + <span class="hljs-subst">${-lookYaw * <span class="hljs-number">0.35</span>}</span>px)) translateY(<span class="hljs-subst">${<span class="hljs-built_in">Math</span>.max(-<span class="hljs-number">15</span>, <span class="hljs-built_in">Math</span>.min(<span class="hljs-number">15</span>, lookPitch * <span class="hljs-number">0.25</span>))}</span>px)`</span>;
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">triggerShootAction</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">if</span> (!inCombat) <span class="hljs-keyword">return</span>;
    crosshair.classList.add(<span class="hljs-string">"recoil"</span>);
    armsRig.classList.add(<span class="hljs-string">"firing"</span>);
    earnedInMatch += activeDifficulty ? activeDifficulty.level * <span class="hljs-number">5</span> : <span class="hljs-number">5</span>;
    combatEarnedMoneyEl.textContent = earnedInMatch;
    combatStatusBadge.textContent = <span class="hljs-string">`Tir effectué ! (+<span class="hljs-subst">${activeDifficulty ? activeDifficulty.level * <span class="hljs-number">5</span> : <span class="hljs-number">5</span>}</span> $)`</span>;

    <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">() =&gt;</span> {
        crosshair.classList.remove(<span class="hljs-string">"recoil"</span>);
        armsRig.classList.remove(<span class="hljs-string">"firing"</span>);
    }, <span class="hljs-number">150</span>);
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">triggerReloadAction</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">if</span> (!inCombat) <span class="hljs-keyword">return</span>;
    armsRig.classList.add(<span class="hljs-string">"reloading"</span>);
    combatStatusBadge.textContent = <span class="hljs-string">"Rechargement en cours..."</span>;
    <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">() =&gt;</span> {
        armsRig.classList.remove(<span class="hljs-string">"reloading"</span>);
        combatStatusBadge.textContent = <span class="hljs-string">`Prêt — Vague <span class="hljs-subst">${currentWave}</span>/<span class="hljs-subst">${totalWaves}</span>`</span>;
    }, <span class="hljs-number">650</span>);
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">triggerSwitchWeaponAction</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">if</span> (!inCombat) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">const</span> owned = weapons.filter(<span class="hljs-function"><span class="hljs-params">w</span> =&gt;</span> w.owned);
    <span class="hljs-keyword">if</span> (owned.length &gt; <span class="hljs-number">1</span>) {
        <span class="hljs-keyword">const</span> idx = owned.findIndex(<span class="hljs-function"><span class="hljs-params">w</span> =&gt;</span> w.id === equippedWeaponId);
        <span class="hljs-keyword">const</span> nextWeapon = owned[(idx + <span class="hljs-number">1</span>) % owned.length];
        equippedWeaponId = nextWeapon.id;
        syncCombatWeaponView();
        combatStatusBadge.textContent = <span class="hljs-string">`Arme sélectionnée : <span class="hljs-subst">${nextWeapon.name}</span>`</span>;
    } <span class="hljs-keyword">else</span> {
        combatStatusBadge.textContent = <span class="hljs-string">"Aucune autre arme possédée pour l'instant"</span>;
    }
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">triggerHealAction</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">if</span> (!inCombat) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">if</span> (healCharges &gt; <span class="hljs-number">0</span>) {
        healCharges--;
        healChargesEl.textContent = healCharges;
        combatStatusBadge.textContent = <span class="hljs-string">`Soins utilisés (<span class="hljs-subst">${healCharges}</span> restant(s))`</span>;
    } <span class="hljs-keyword">else</span> {
        combatStatusBadge.textContent = <span class="hljs-string">"Plus de soins disponibles"</span>;
    }
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">triggerMoveDirection</span>(<span class="hljs-params">dir, pressed</span>) </span>{
    <span class="hljs-keyword">if</span> (!inCombat) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">const</span> btn = <span class="hljs-built_in">document</span>.querySelector(<span class="hljs-string">`.move-key[data-move="<span class="hljs-subst">${dir}</span>"]`</span>);
    <span class="hljs-keyword">if</span> (btn) {
        btn.classList.toggle(<span class="hljs-string">"pressed"</span>, pressed);
    }
    <span class="hljs-keyword">if</span> (pressed) {
        <span class="hljs-keyword">const</span> labels = { <span class="hljs-attr">z</span>: <span class="hljs-string">"Avance (Z)"</span>, <span class="hljs-attr">s</span>: <span class="hljs-string">"Recule (S)"</span>, <span class="hljs-attr">q</span>: <span class="hljs-string">"Gauche (Q)"</span>, <span class="hljs-attr">d</span>: <span class="hljs-string">"Droite (D)"</span> };
        combatStatusBadge.textContent = <span class="hljs-string">`Déplacement : <span class="hljs-subst">${labels[dir] || dir}</span>`</span>;
    }
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">stopCombatSession</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">if</span> (!inCombat &amp;&amp; combatScreen.classList.contains(<span class="hljs-string">"hidden"</span>)) <span class="hljs-keyword">return</span>;
    inCombat = <span class="hljs-literal">false</span>;
    money += earnedInMatch;
    updateMoneyUI();
    combatScreen.classList.add(<span class="hljs-string">"hidden"</span>);
    <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"side-menu"</span>).classList.remove(<span class="hljs-string">"hidden"</span>);
}

<span class="hljs-comment">// Boutons HUD de combat</span>
<span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"btn-stop-game"</span>).addEventListener(<span class="hljs-string">"click"</span>, stopCombatSession);
<span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"btn-combat-shoot"</span>).addEventListener(<span class="hljs-string">"click"</span>, triggerShootAction);
<span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"btn-combat-reload"</span>).addEventListener(<span class="hljs-string">"click"</span>, triggerReloadAction);
<span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"btn-combat-switch"</span>).addEventListener(<span class="hljs-string">"click"</span>, triggerSwitchWeaponAction);
<span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"btn-combat-heal"</span>).addEventListener(<span class="hljs-string">"click"</span>, triggerHealAction);

<span class="hljs-built_in">document</span>.querySelectorAll(<span class="hljs-string">".move-key"</span>).forEach(<span class="hljs-function"><span class="hljs-params">btn</span> =&gt;</span> {
    <span class="hljs-keyword">const</span> dir = btn.dataset.move;
    btn.addEventListener(<span class="hljs-string">"mousedown"</span>, <span class="hljs-function">() =&gt;</span> triggerMoveDirection(dir, <span class="hljs-literal">true</span>));
    btn.addEventListener(<span class="hljs-string">"mouseup"</span>, <span class="hljs-function">() =&gt;</span> triggerMoveDirection(dir, <span class="hljs-literal">false</span>));
    btn.addEventListener(<span class="hljs-string">"mouseleave"</span>, <span class="hljs-function">() =&gt;</span> triggerMoveDirection(dir, <span class="hljs-literal">false</span>));
    btn.addEventListener(<span class="hljs-string">"touchstart"</span>, <span class="hljs-function"><span class="hljs-params">e</span> =&gt;</span> {
        e.preventDefault();
        triggerMoveDirection(dir, <span class="hljs-literal">true</span>);
    });
    btn.addEventListener(<span class="hljs-string">"touchend"</span>, <span class="hljs-function">() =&gt;</span> triggerMoveDirection(dir, <span class="hljs-literal">false</span>));
});

<span class="hljs-comment">// Souris &amp; clics en combat : mouvement de visée, clic gauche = tirer, clic droit = recharger</span>
combatViewLayer.addEventListener(<span class="hljs-string">"mousemove"</span>, <span class="hljs-function"><span class="hljs-params">e</span> =&gt;</span> {
    <span class="hljs-keyword">if</span> (!inCombat) <span class="hljs-keyword">return</span>;
    lookYaw += e.movementX * <span class="hljs-number">0.18</span>;
    lookPitch = <span class="hljs-built_in">Math</span>.max(-<span class="hljs-number">60</span>, <span class="hljs-built_in">Math</span>.min(<span class="hljs-number">60</span>, lookPitch + e.movementY * <span class="hljs-number">0.18</span>));
    updateViewLook();
});

combatViewLayer.addEventListener(<span class="hljs-string">"mousedown"</span>, <span class="hljs-function"><span class="hljs-params">e</span> =&gt;</span> {
    <span class="hljs-keyword">if</span> (!inCombat) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">if</span> (e.button === <span class="hljs-number">0</span>) {
        triggerShootAction();
    } <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span> (e.button === <span class="hljs-number">2</span>) {
        triggerReloadAction();
    }
});

combatViewLayer.addEventListener(<span class="hljs-string">"contextmenu"</span>, <span class="hljs-function"><span class="hljs-params">e</span> =&gt;</span> {
    <span class="hljs-keyword">if</span> (inCombat) e.preventDefault();
});

<span class="hljs-comment">// Clavier Z / Q / S / D et Échap</span>
<span class="hljs-built_in">document</span>.addEventListener(<span class="hljs-string">"keydown"</span>, <span class="hljs-function"><span class="hljs-params">e</span> =&gt;</span> {
    <span class="hljs-keyword">if</span> (!inCombat) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">const</span> key = e.key.toLowerCase();
    <span class="hljs-keyword">if</span> (key === <span class="hljs-string">"escape"</span>) {
        stopCombatSession();
    } <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span> ([<span class="hljs-string">"z"</span>, <span class="hljs-string">"q"</span>, <span class="hljs-string">"s"</span>, <span class="hljs-string">"d"</span>].includes(key)) {
        triggerMoveDirection(key, <span class="hljs-literal">true</span>);
    }
});

<span class="hljs-built_in">document</span>.addEventListener(<span class="hljs-string">"keyup"</span>, <span class="hljs-function"><span class="hljs-params">e</span> =&gt;</span> {
    <span class="hljs-keyword">if</span> (!inCombat) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">const</span> key = e.key.toLowerCase();
    <span class="hljs-keyword">if</span> ([<span class="hljs-string">"z"</span>, <span class="hljs-string">"q"</span>, <span class="hljs-string">"s"</span>, <span class="hljs-string">"d"</span>].includes(key)) {
        triggerMoveDirection(key, <span class="hljs-literal">false</span>);
    }
});
