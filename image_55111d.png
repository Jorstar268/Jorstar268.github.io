<span class="hljs-keyword">let</span> recoilPitch3D = <span class="hljs-number">0</span>;
<span class="hljs-keyword">let</span> reloadAnim3D = <span class="hljs-number">0</span>;
<span class="hljs-keyword">let</span> walkBobTime3D = <span class="hljs-number">0</span>;
<span class="hljs-keyword">let</span> activeMoveKeys = { <span class="hljs-attr">z</span>: <span class="hljs-literal">false</span>, <span class="hljs-attr">q</span>: <span class="hljs-literal">false</span>, <span class="hljs-attr">s</span>: <span class="hljs-literal">false</span>, <span class="hljs-attr">d</span>: <span class="hljs-literal">false</span> };

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">initThreeFPS</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">if</span> (!<span class="hljs-built_in">window</span>.THREE || !fps3dWrap || renderer3D) <span class="hljs-keyword">return</span>;

    scene3D = <span class="hljs-keyword">new</span> THREE.Scene();

