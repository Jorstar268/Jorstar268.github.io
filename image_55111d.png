}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">startCombatWithRectangles</span>(<span class="hljs-params">diff</span>) </span>{
    sideMenu.classList.add(<span class="hljs-string">"hidden"</span>);
    panelShop.classList.add(<span class="hljs-string">"hidden"</span>);
    panelUpgrade.classList.add(<span class="hljs-string">"hidden"</span>);
    pauseOverlay.classList.add(<span class="hljs-string">"hidden"</span>);

    activeDifficulty = diff;
    earnedInMatch = <span class="hljs-number">0</span>;
    healCharges = <span class="hljs-number">3</span>;
    playerMaxHp = <span class="hljs-number">100</span>;
    playerHp = <span class="hljs-number">100</span>;
    currentWave = <span class="hljs-number">1</span>;
    lookYaw = <span class="hljs-number">0</span>;
    lookPitch = <span class="hljs-number">0</span>;
    isPaused = <span class="hljs-literal">false</span>;
    isReloading = <span class="hljs-literal">false</span>;
    recoilOffset3D = <span class="hljs-number">0</span>;
    recoilPitch3D = <span class="hljs-number">0</span>;
    reloadAnim3D = <span class="hljs-number">0</span>;
    activeMoveKeys = { <span class="hljs-attr">z</span>: <span class="hljs-literal">false</span>, <span class="hljs-attr">q</span>: <span class="hljs-literal">false</span>, <span class="hljs-attr">s</span>: <span class="hljs-literal">false</span>, <span class="hljs-attr">d</span>: <span class="hljs-literal">false</span> };

    initMatchAmmo();
    combatEarnedMoneyEl.textContent = earnedInMatch;
    healChargesEl.textContent = healCharges;
    updatePlayerHpUI();
    renderWaveSegments(currentWave);
    resetZombieForWave();
    syncCombatWeaponView();
    updateViewLook();

    <span class="hljs-keyword">const</span> rects = build20Rectangles();
    transitionGrid.classList.remove(<span class="hljs-string">"hidden"</span>);

    rects.forEach(<span class="hljs-function">(<span class="hljs-params">rect, index</span>) =&gt;</span> {
        <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">() =&gt;</span> {
            rect.classList.add(<span class="hljs-string">"rect-hidden"</span>);
            <span class="hljs-keyword">if</span> (index === rects.length - <span class="hljs-number">1</span>) {
                <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">() =&gt;</span> {
                    transitionGrid.classList.add(<span class="hljs-string">"hidden"</span>);
                    transitionGrid.innerHTML = <span class="hljs-string">""</span>;
                    combatScreen.classList.remove(<span class="hljs-string">"hidden"</span>);
                    inCombat = <span class="hljs-literal">true</span>;
                    initThreeFPS();
                    build3DWeaponMesh(equippedWeaponId);
                    handleResize3D();
                    combatStatusBadge.textContent =
                        <span class="hljs-string">`Difficulté <span class="hljs-subst">${diff.level}</span> (<span class="hljs-subst">${diff.name}</span>) — Vague <span class="hljs-subst">${currentWave}</span>/<span class="hljs-subst">${totalWaves}</span>`</span>;
                }, <span class="hljs-number">220</span>);
            }
        }, index * <span class="hljs-number">55</span>);
    });
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">renderWaveSegments</span>(<span class="hljs-params">waveNum</span>) </span>{
    <span class="hljs-keyword">const</span> container = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"wave-segments"</span>);
    container.innerHTML = <span class="hljs-string">""</span>;
    <span class="hljs-keyword">for</span> (<span class="hljs-keyword">let</span> i = <span class="hljs-number">1</span>; i &lt;= totalWaves; i++) {
        <span class="hljs-keyword">const</span> seg = <span class="hljs-built_in">document</span>.createElement(<span class="hljs-string">"div"</span>);
        seg.className = <span class="hljs-string">`wave-seg <span class="hljs-subst">${i &lt;= waveNum ? <span class="hljs-string">"active"</span> : <span class="hljs-string">""</span>}</span>`</span>;
        container.appendChild(seg);
    }
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">syncCombatWeaponView</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">const</span> equipped = weapons.find(<span class="hljs-function"><span class="hljs-params">w</span> =&gt;</span> w.id === equippedWeaponId) || weapons[<span class="hljs-number">0</span>];
    combatWeaponLabel.textContent = <span class="hljs-string">`<span class="hljs-subst">${equipped.name}</span> (Niv. <span class="hljs-subst">${equipped.level}</span>)`</span>;
    build3DWeaponMesh(equipped.id);
    updateAmmoUI();
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">updateViewLook</span>(<span class="hljs-params"></span>) </span>{
    combatViewLayer.style.backgroundPosition = <span class="hljs-string">`<span class="hljs-subst">${<span class="hljs-number">50</span> + lookYaw * <span class="hljs-number">0.25</span>}</span>% <span class="hljs-subst">${<span class="hljs-number">50</span> + lookPitch * <span class="hljs-number">0.25</span>}</span>%`</span>;
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">onZombieKilled</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">const</span> killReward = (activeDifficulty ? activeDifficulty.level : <span class="hljs-number">1</span>) * <span class="hljs-number">15</span>;
    earnedInMatch += killReward;
    combatEarnedMoneyEl.textContent = earnedInMatch;

    <span class="hljs-keyword">if</span> (currentWave &lt; totalWaves) {
        currentWave++;
        renderWaveSegments(currentWave);
        combatStatusBadge.textContent = <span class="hljs-string">`Zombie éliminé (+<span class="hljs-subst">${killReward}</span> $) — Vague <span class="hljs-subst">${currentWave}</span>/<span class="hljs-subst">${totalWaves}</span>`</span>;
    } <span class="hljs-keyword">else</span> {
        combatStatusBadge.textContent = <span class="hljs-string">`Zombie éliminé (+<span class="hljs-subst">${killReward}</span> $) — Vague Boss atteinte !`</span>;
    }
    resetZombieForWave();
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">triggerShootAction</span>(<span class="hljs-params">hitZombie = <span class="hljs-literal">false</span></span>) </span>{
    <span class="hljs-keyword">if</span> (!inCombat || isPaused || isReloading) <span class="hljs-keyword">return</span>;

    <span class="hljs-keyword">const</span> equipped = weapons.find(<span class="hljs-function"><span class="hljs-params">w</span> =&gt;</span> w.id === equippedWeaponId) || weapons[<span class="hljs-number">0</span>];
    <span class="hljs-keyword">const</span> currentAmmo = getCurrentWeaponAmmo(equipped);

    <span class="hljs-keyword">if</span> (currentAmmo &lt;= <span class="hljs-number">0</span>) {
        combatStatusBadge.textContent = <span class="hljs-string">"Chargeur vide ! Appuyez sur RELOAD ou clic droit."</span>;
        <span class="hljs-keyword">return</span>;
    }

    ammoByWeaponId[equipped.id] = currentAmmo - <span class="hljs-number">1</span>;
    updateAmmoUI();

    recoilOffset3D = <span class="hljs-number">0.09</span>;
    recoilPitch3D = <span class="hljs-number">0.14</span>;

    <span class="hljs-keyword">const</span> s = getStatsAtLevel(equipped, equipped.level);

    <span class="hljs-keyword">if</span> (hitZombie) {
        zombieTargetBtn.classList.add(<span class="hljs-string">"hit-flash"</span>);
        zombieHp -= s.dmgClose;
        updateZombieHpUI();
        combatStatusBadge.textContent = <span class="hljs-string">`Touché (-<span class="hljs-subst">${s.dmgClose}</span> PV)`</span>;
        <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">() =&gt;</span> zombieTargetBtn.classList.remove(<span class="hljs-string">"hit-flash"</span>), <span class="hljs-number">120</span>);

        <span class="hljs-keyword">if</span> (zombieHp &lt;= <span class="hljs-number">0</span>) {
            onZombieKilled();
        }
    } <span class="hljs-keyword">else</span> {
        combatStatusBadge.textContent = <span class="hljs-string">`Tir (<span class="hljs-subst">${equipped.name}</span>) — <span class="hljs-subst">${ammoByWeaponId[equipped.id]}</span> munition(s) restante(s)`</span>;
    }
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">triggerReloadAction</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">if</span> (!inCombat || isPaused || isReloading) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">const</span> equipped = weapons.find(<span class="hljs-function"><span class="hljs-params">w</span> =&gt;</span> w.id === equippedWeaponId) || weapons[<span class="hljs-number">0</span>];
    <span class="hljs-keyword">const</span> maxAmmo = getCurrentWeaponMaxAmmo(equipped);
    <span class="hljs-keyword">const</span> curAmmo = getCurrentWeaponAmmo(equipped);

    <span class="hljs-keyword">if</span> (curAmmo &gt;= maxAmmo) {
        combatStatusBadge.textContent = <span class="hljs-string">"Chargeur déjà plein."</span>;
        <span class="hljs-keyword">return</span>;
    }

    isReloading = <span class="hljs-literal">true</span>;
    combatStatusBadge.textContent = <span class="hljs-string">"Rechargement en cours..."</span>;

    <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">() =&gt;</span> {
        ammoByWeaponId[equipped.id] = maxAmmo;
        updateAmmoUI();
        isReloading = <span class="hljs-literal">false</span>;
        <span class="hljs-keyword">if</span> (inCombat &amp;&amp; !isPaused) {
            combatStatusBadge.textContent = <span class="hljs-string">`Chargeur rechargé — Vague <span class="hljs-subst">${currentWave}</span>/<span class="hljs-subst">${totalWaves}</span>`</span>;
        }
    }, <span class="hljs-number">650</span>);
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">triggerSwitchWeaponAction</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">if</span> (!inCombat || isPaused) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">const</span> owned = weapons.filter(<span class="hljs-function"><span class="hljs-params">w</span> =&gt;</span> w.owned);
    <span class="hljs-keyword">if</span> (owned.length &gt; <span class="hljs-number">1</span>) {
        <span class="hljs-keyword">const</span> idx = owned.findIndex(<span class="hljs-function"><span class="hljs-params">w</span> =&gt;</span> w.id === equippedWeaponId);
        <span class="hljs-keyword">const</span> nextWeapon = owned[(idx + <span class="hljs-number">1</span>) % owned.length];
        equippedWeaponId = nextWeapon.id;
        syncCombatWeaponView();
        combatStatusBadge.textContent = <span class="hljs-string">`Arme sélectionnée : <span class="hljs-subst">${nextWeapon.name}</span>`</span>;
    } <span class="hljs-keyword">else</span> {
        combatStatusBadge.textContent = <span class="hljs-string">"Aucune autre arme possédée pour l'instant"</span>;
    }
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">triggerHealAction</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">if</span> (!inCombat || isPaused) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">if</span> (healCharges &gt; <span class="hljs-number">0</span> &amp;&amp; playerHp &lt; playerMaxHp) {
        healCharges--;
        playerHp = <span class="hljs-built_in">Math</span>.min(playerMaxHp, playerHp + <span class="hljs-number">35</span>);
        healChargesEl.textContent = healCharges;
        updatePlayerHpUI();
        combatStatusBadge.textContent = <span class="hljs-string">`Soins (+35 PV) — <span class="hljs-subst">${healCharges}</span> soin(s) restant(s)`</span>;
    } <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span> (healCharges &lt;= <span class="hljs-number">0</span>) {
        combatStatusBadge.textContent = <span class="hljs-string">"Plus de soins disponibles"</span>;
    } <span class="hljs-keyword">else</span> {
        combatStatusBadge.textContent = <span class="hljs-string">"Vie déjà au maximum"</span>;
    }
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">triggerMoveDirection</span>(<span class="hljs-params">dir, pressed</span>) </span>{
    <span class="hljs-keyword">if</span> (!inCombat || isPaused) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">if</span> (dir <span class="hljs-keyword">in</span> activeMoveKeys) {
        activeMoveKeys[dir] = pressed;
    }
    <span class="hljs-keyword">const</span> btn = <span class="hljs-built_in">document</span>.querySelector(<span class="hljs-string">`.move-key[data-move="<span class="hljs-subst">${dir}</span>"]`</span>);
    <span class="hljs-keyword">if</span> (btn) {
        btn.classList.toggle(<span class="hljs-string">"pressed"</span>, pressed);
    }
    <span class="hljs-keyword">if</span> (pressed) {
        <span class="hljs-keyword">const</span> labels = { <span class="hljs-attr">z</span>: <span class="hljs-string">"Avance (Z)"</span>, <span class="hljs-attr">s</span>: <span class="hljs-string">"Recule (S)"</span>, <span class="hljs-attr">q</span>: <span class="hljs-string">"Gauche (Q)"</span>, <span class="hljs-attr">d</span>: <span class="hljs-string">"Droite (D)"</span> };
        combatStatusBadge.textContent = <span class="hljs-string">`Déplacement : <span class="hljs-subst">${labels[dir] || dir}</span>`</span>;
    }
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">togglePauseGame</span>(<span class="hljs-params">forcePause = <span class="hljs-literal">null</span></span>) </span>{
    <span class="hljs-keyword">if</span> (!inCombat) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">const</span> nextState = forcePause !== <span class="hljs-literal">null</span> ? forcePause : !isPaused;
    isPaused = nextState;
    pauseOverlay.classList.toggle(<span class="hljs-string">"hidden"</span>, !isPaused);
    <span class="hljs-keyword">if</span> (isPaused) {
        combatStatusBadge.textContent = <span class="hljs-string">"Partie en pause"</span>;
    } <span class="hljs-keyword">else</span> {
        combatStatusBadge.textContent = <span class="hljs-string">`Reprise — Vague <span class="hljs-subst">${currentWave}</span>/<span class="hljs-subst">${totalWaves}</span>`</span>;
    }
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">quitCombatSession</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">if</span> (!inCombat &amp;&amp; combatScreen.classList.contains(<span class="hljs-string">"hidden"</span>)) <span class="hljs-keyword">return</span>;
    inCombat = <span class="hljs-literal">false</span>;
    isPaused = <span class="hljs-literal">false</span>;
    isReloading = <span class="hljs-literal">false</span>;
    activeMoveKeys = { <span class="hljs-attr">z</span>: <span class="hljs-literal">false</span>, <span class="hljs-attr">q</span>: <span class="hljs-literal">false</span>, <span class="hljs-attr">s</span>: <span class="hljs-literal">false</span>, <span class="hljs-attr">d</span>: <span class="hljs-literal">false</span> };
    pauseOverlay.classList.add(<span class="hljs-string">"hidden"</span>);
    combatScreen.classList.add(<span class="hljs-string">"hidden"</span>);

    money += earnedInMatch;
    earnedInMatch = <span class="hljs-number">0</span>;
    combatEarnedMoneyEl.textContent = <span class="hljs-number">0</span>;
    updateMoneyUI();

    sideMenu.classList.remove(<span class="hljs-string">"hidden"</span>);
}

<span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"btn-stop-game"</span>).addEventListener(<span class="hljs-string">"click"</span>, <span class="hljs-function">() =&gt;</span> togglePauseGame(<span class="hljs-literal">true</span>));
<span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"btn-resume-game"</span>).addEventListener(<span class="hljs-string">"click"</span>, <span class="hljs-function">() =&gt;</span> togglePauseGame(<span class="hljs-literal">false</span>));
<span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"btn-quit-game"</span>).addEventListener(<span class="hljs-string">"click"</span>, quitCombatSession);

<span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"btn-combat-shoot"</span>).addEventListener(<span class="hljs-string">"click"</span>, <span class="hljs-function">() =&gt;</span> triggerShootAction(<span class="hljs-literal">false</span>));
<span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"btn-combat-reload"</span>).addEventListener(<span class="hljs-string">"click"</span>, triggerReloadAction);
<span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"btn-combat-switch"</span>).addEventListener(<span class="hljs-string">"click"</span>, triggerSwitchWeaponAction);
<span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"btn-combat-heal"</span>).addEventListener(<span class="hljs-string">"click"</span>, triggerHealAction);

zombieTargetBtn.addEventListener(<span class="hljs-string">"mousedown"</span>, <span class="hljs-function"><span class="hljs-params">e</span> =&gt;</span> {
    e.stopPropagation();
    <span class="hljs-keyword">if</span> (e.button === <span class="hljs-number">0</span>) {
        triggerShootAction(<span class="hljs-literal">true</span>);
    }
});

<span class="hljs-built_in">document</span>.querySelectorAll(<span class="hljs-string">".move-key"</span>).forEach(<span class="hljs-function"><span class="hljs-params">btn</span> =&gt;</span> {
    <span class="hljs-keyword">const</span> dir = btn.dataset.move;
    btn.addEventListener(<span class="hljs-string">"mousedown"</span>, <span class="hljs-function">() =&gt;</span> triggerMoveDirection(dir, <span class="hljs-literal">true</span>));
    btn.addEventListener(<span class="hljs-string">"mouseup"</span>, <span class="hljs-function">() =&gt;</span> triggerMoveDirection(dir, <span class="hljs-literal">false</span>));
    btn.addEventListener(<span class="hljs-string">"mouseleave"</span>, <span class="hljs-function">() =&gt;</span> triggerMoveDirection(dir, <span class="hljs-literal">false</span>));
    btn.addEventListener(<span class="hljs-string">"touchstart"</span>, <span class="hljs-function"><span class="hljs-params">e</span> =&gt;</span> {
        e.preventDefault();
        triggerMoveDirection(dir, <span class="hljs-literal">true</span>);
    });
    btn.addEventListener(<span class="hljs-string">"touchend"</span>, <span class="hljs-function">() =&gt;</span> triggerMoveDirection(dir, <span class="hljs-literal">false</span>));
});

combatViewLayer.addEventListener(<span class="hljs-string">"mousemove"</span>, <span class="hljs-function"><span class="hljs-params">e</span> =&gt;</span> {
    <span class="hljs-keyword">if</span> (!inCombat || isPaused) <span class="hljs-keyword">return</span>;
    lookYaw += e.movementX * <span class="hljs-number">0.18</span>;
    lookPitch = <span class="hljs-built_in">Math</span>.max(-<span class="hljs-number">60</span>, <span class="hljs-built_in">Math</span>.min(<span class="hljs-number">60</span>, lookPitch + e.movementY * <span class="hljs-number">0.18</span>));
    updateViewLook();
});

combatViewLayer.addEventListener(<span class="hljs-string">"mousedown"</span>, <span class="hljs-function"><span class="hljs-params">e</span> =&gt;</span> {
    <span class="hljs-keyword">if</span> (!inCombat || isPaused) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">if</span> (e.button === <span class="hljs-number">0</span>) {
        triggerShootAction(<span class="hljs-literal">false</span>);
    } <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span> (e.button === <span class="hljs-number">2</span>) {
        triggerReloadAction();
    }
});

combatViewLayer.addEventListener(<span class="hljs-string">"contextmenu"</span>, <span class="hljs-function"><span class="hljs-params">e</span> =&gt;</span> {
    <span class="hljs-keyword">if</span> (inCombat) e.preventDefault();
});

<span class="hljs-built_in">document</span>.addEventListener(<span class="hljs-string">"keydown"</span>, <span class="hljs-function"><span class="hljs-params">e</span> =&gt;</span> {
    <span class="hljs-keyword">if</span> (!inCombat) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">const</span> key = e.key.toLowerCase();
    <span class="hljs-keyword">if</span> (key === <span class="hljs-string">"escape"</span>) {
        togglePauseGame();
    } <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span> (!isPaused &amp;&amp; key === <span class="hljs-string">"r"</span>) {
        triggerReloadAction();
    } <span class="hljs-keyword">else</span> <span class="hljs-keyword">if</span> (!isPaused &amp;&amp; [<span class="hljs-string">"z"</span>, <span class="hljs-string">"q"</span>, <span class="hljs-string">"s"</span>, <span class="hljs-string">"d"</span>].includes(key)) {
        triggerMoveDirection(key, <span class="hljs-literal">true</span>);
    }
});

<span class="hljs-built_in">document</span>.addEventListener(<span class="hljs-string">"keyup"</span>, <span class="hljs-function"><span class="hljs-params">e</span> =&gt;</span> {
    <span class="hljs-keyword">if</span> (!inCombat) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">const</span> key = e.key.toLowerCase();
    <span class="hljs-keyword">if</span> ([<span class="hljs-string">"z"</span>, <span class="hljs-string">"q"</span>, <span class="hljs-string">"s"</span>, <span class="hljs-string">"d"</span>].includes(key)) {
        triggerMoveDirection(key, <span class="hljs-literal">false</span>);
    }
});
</code></pre><!----></div></div></div><!----><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p dir="ltr" data-path-to-node="5"><span>Faites bien attention à </span><b data-path-to-node="5" data-index-in-node="24">supprimer l'ancien bloc</b><span> (qui contient </span><code data-path-to-node="5" data-index-in-node="62">const armsRig = document.getElementById("player-arms-weapon")</code><span> et </span><code data-path-to-node="5" data-index-in-node="127">const combatWeaponImg</code><span>) afin qu'il n'y ait pas de variables déclarées deux fois.</span></p><p dir="ltr" data-path-to-node="6"><span>Une fois enregistré,</span><span> rechargez avec </span><b data-path-to-node="6" data-index-in-node="36"><code data-path-to-node="6" data-index-in-node="36">Ctrl + Shift + R</code></b><span> et lancez une partie :</span><span> vous verrez alors la scène 3D avec les mains et l'arme.</span><span> Est-ce que ça s'affiche bien ainsi ?</span></p></div><!----></message-content><!----><!----></div></structured-content-container><!----><!----></div><!----><!----></model-response-content><!----><!----><!----><!----><div _ngcontent-ng-c1028177799="" class="response-footer gap complete"><!----><!----><!----><sources-list _ngcontent-ng-c1028177799="" class="sources-list ng-star-inserted"><!----></sources-list><!----><!----><election-info-disclaimer _ngcontent-ng-c1028177799="" _nghost-ng-c33