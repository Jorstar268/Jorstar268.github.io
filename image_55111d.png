<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">updateMoneyUI</span>(<span class="hljs-params"></span>) </span>{
    moneyDisplay.textContent = money;
    shopMoneyDisplay.textContent = money;
    upgradeMoneyDisplay.textContent = money;
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">getStatsAtLevel</span>(<span class="hljs-params">weapon, level</span>) </span>{
    <span class="hljs-keyword">const</span> diff = level - <span class="hljs-number">1</span>;
    <span class="hljs-keyword">const</span> reloadTime = <span class="hljs-built_in">Math</span>.max(<span class="hljs-number">0.15</span>, +(weapon.stats.reloadTime + diff * weapon.step.reloadTime).toFixed(<span class="hljs-number">2</span>));
    <span class="hljs-keyword">const</span> fireRate = +(weapon.stats.fireRate + diff * weapon.step.fireRate).toFixed(<span class="hljs-number">2</span>);
    <span class="hljs-keyword">return</span> {
        <span class="hljs-attr">ammo</span>: <span class="hljs-built_in">Math</span>.round(weapon.stats.ammo + diff * weapon.step.ammo),
        reloadTime,
        fireRate,
        <span class="hljs-attr">dmgClose</span>: <span class="hljs-built_in">Math</span>.round(weapon.stats.dmgClose + diff * weapon.step.dmgClose),
        <span class="hljs-attr">dmgMid</span>: <span class="hljs-built_in">Math</span>.round(weapon.stats.dmgMid + diff * weapon.step.dmgMid),
        <span class="hljs-attr">dmgFar</span>: <span class="hljs-built_in">Math</span>.round(weapon.stats.dmgFar + diff * weapon.step.dmgFar)
    };
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">formatRangeDamage</span>(<span class="hljs-params">s</span>) </span>{
    <span class="hljs-keyword">return</span> <span class="hljs-string">`Proche <span class="hljs-subst">${s.dmgClose}</span> / Moy. <span class="hljs-subst">${s.dmgMid}</span> / Loin <span class="hljs-subst">${s.dmgFar}</span>`</span>;
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">renderStatsRows</span>(<span class="hljs-params">s</span>) </span>{
