            <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"upgrade-compare"</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"upgrade-compare-col"</span>&gt;</span>
