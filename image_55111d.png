<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">animate3DLoop</span>(<span class="hljs-params"></span>) </span>{
    requestAnimationFrame(animate3DLoop);
    <span class="hljs-keyword">if</span> (!renderer3D || !scene3D || !camera3D || !rigRoot3D) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">if</span> (!inCombat || isPaused) {
        renderer3D.render(scene3D, camera3D);
        <span class="hljs-keyword">return</span>;
    }

    <span class="hljs-keyword">const</span> moving = activeMoveKeys.z || activeMoveKeys.q || activeMoveKeys.s || activeMoveKeys.d;
    walkBobTime3D += moving ? <span class="hljs-number">0.14</span> : <span class="hljs-number">0.03</span>;

    <span class="hljs-keyword">const</span> bobAmp = moving ? <span class="hljs-number">0.022</span> : <span class="hljs-number">0.005</span>;
    <span class="hljs-keyword">const</span> bobX = <span class="hljs-built_in">Math</span>.cos(walkBobTime3D) * bobAmp;
    <span class="hljs-keyword">const</span> bobY = <span class="hljs-built_in">Math</span>.abs(<span class="hljs-built_in">Math</span>.sin(walkBobTime3D)) * bobAmp;

    recoilOffset3D *= <span class="hljs-number">0.82</span>;
    recoilPitch3D *= <span class="hljs-number">0.82</span>;

    <span class="hljs-keyword">if</span> (isReloading) {
        reloadAnim3D = <span class="hljs-built_in">Math</span>.min(<span class="hljs-number">1</span>, reloadAnim3D + <span class="hljs-number">0.12</span>);
    } <span class="hljs-keyword">else</span> {
        reloadAnim3D = <span class="hljs-built_in">Math</span>.max(<span class="hljs-number">0</span>, reloadAnim3D - <span class="hljs-number">0.12</span>);
    }

    rigRoot3D.position.x = bobX - lookYaw * <span class="hljs-number">0.0022</span>;
    rigRoot3D.position.y = -<span class="hljs-number">0.42</span> - bobY - reloadAnim3D * <span class="hljs-number">0.18</span> - lookPitch * <span class="hljs-number">0.0016</span>;
    rigRoot3D.position.z = <span class="hljs-number">0.75</span> + recoilOffset3D;

    rigRoot3D.rotation.x = recoilPitch3D - reloadAnim3D * <span class="hljs-number">0.45</span> - lookPitch * <span class="hljs-number">0.004</span>;
    rigRoot3D.rotation.y = -lookYaw * <span class="hljs-number">0.005</span>;
    rigRoot3D.rotation.z = reloadAnim3D * <span class="hljs-number">0.22</span>;

    renderer3D.render(scene3D, camera3D);
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">initMatchAmmo</span>(<span class="hljs-params"></span>) </span>{
    ammoByWeaponId = {};
