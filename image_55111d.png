    renderShop();
});

<span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"btn-upgrade"</span>).addEventListener(<span class="hljs-string">"click"</span>, <span class="hljs-function">() =&gt;</span> {
    panelShop.classList.add(<span class="hljs-string">"hidden"</span>);
    panelUpgrade.classList.toggle(<span class="hljs-string">"hidden"</span>);
    updateMoneyUI();
    renderUpgrades();
});

<span class="hljs-built_in">document</span>.querySelectorAll(<span class="hljs-string">".close-btn"</span>).forEach(<span class="hljs-function"><span class="hljs-params">btn</span> =&gt;</span> {
    btn.addEventListener(<span class="hljs-string">"click"</span>, <span class="hljs-function">() =&gt;</span> {
