}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">updateAmmoUI</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">const</span> equipped = weapons.find(<span class="hljs-function"><span class="hljs-params">w</span> =&gt;</span> w.id === equippedWeaponId) || weapons[<span class="hljs-number">0</span>];
    <span class="hljs-keyword">const</span> cur = getCurrentWeaponAmmo(equipped);
