<span class="hljs-tag">&lt;<span class="hljs-name">script</span> <span class="hljs-attr">src</span>=<span class="hljs-string">"https://unpkg.com/three@0.160.0/examples/js/loaders/GLTFLoader.js"</span>&gt;</span><span class="hljs-tag">&lt;/<span class="hljs-name">script</span>&gt;</span>
<span class="hljs-tag">&lt;<span class="hljs-name">script</span> <span class="hljs-attr">src</span>=<span class="hljs-string">"script.js"</span>&gt;</span><span class="hljs-tag">&lt;/<span class="hljs-name">script</span>&gt;</span>
</code></pre><!----></div></div></div><!----><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p dir="ltr" data-path-to-node="2,1,2"><i data-path-to-node="2,1,2" data-index-in-node="0">(Note : pour charger des fichiers <code data-path-to-node="2,1,2" data-index-in-node="34">.glb</code> locaux sans erreur de sécurité navigateur <code data-path-to-node="2,1,2" data-index-in-node="81">CORS</code>, ouvrez votre projet via un petit serveur local comme l'extension <b data-path-to-node="2,1,2" data-index-in-node="152">Live Server</b> sur VS Code, plutôt qu'en double-cliquant sur <code data-path-to-node="2,1,2" data-index-in-node="210">index.html</code>.)</i></p></li><li><p dir="ltr" data-path-to-node="2,2,0"><b data-path-to-node="2,2,0" data-index-in-node="0">Brancher les modèles <code data-path-to-node="2,2,0" data-index-in-node="21">.glb</code> dans <code data-path-to-node="2,2,0" data-index-in-node="31">script.js</code> (avec repli automatique)</b><span>
Vous pouvez associer un chemin </span><code data-path-to-node="2,2,0" data-index-in-node="97">.glb</code><span class=""> à chaque arme et conserver vos formes simples uniquement en secours tant qu'un fichier n'est pas encore déposé :</span></p><response-element class="no-md" ng-version="0.0.0-PLACEHOLDER" style="--animation-duration: 900ms;"><!----><!----><!----><!----><!----><!----><code-block _nghost-ng-c2260553123="" class="ng-tns-c2260553123-102 enable-luminous-code-block ng-star-inserted" style=""><!----><!----><div _ngcontent-ng-c2260553123="" class="code-block ng-tns-c2260553123-102 ng-animate-disabled ng-trigger ng-trigger-codeBlockRevealAnimation" jslog="223238;track:impression,attention;BardVeMetadataKey:W1sicl8wY2I3NzMwMTIwMDI1ZDBmIiwiY18xNjNhNjhlNzE2NWIxMDY2IixudWxsLCJyY181ZDlkOGFlOThlOWRmNzAzIixudWxsLG51bGwsImZyIixudWxsLDEsbnVsbCxudWxsLDAsMF1d" style="display: block;" data-hveid="0" decode-data-ved="1" data-ved="0CAAQhtANahgKEwj-nfCQlZiYAxUAAAAAHQAAAAAQjwk"><!----><div _ngcontent-ng-c2260553123="" class="formatted-code-block-internal-container ng-tns-c2260553123-102"><div _ngcontent-ng-c2260553123="" class="animated-opacity ng-tns-c2260553123-102"><div _ngcontent-ng-c2260553123="" class="code-block-decoration header-formatted gds-emphasized-body-m ng-tns-c2260553123-102 ng-star-inserted" style=""><span _ngcontent-ng-c2260553123="" class="ng-tns-c2260553123-102">JavaScript</span><div _ngcontent-ng-c2260553123="" class="buttons ng-tns-c2260553123-102 ng-star-inserted"><gem-icon-button _ngcontent-ng-c2260553123="" type="onSurface" size="small" fonticonname="arrow_circle_down" theme="lm" arialabel="Download code" gemtooltip="Download code" class="mat-mdc-tooltip-trigger download-button ng-tns-c2260553123-102 gem-button gem-button-badge-size-small gem-button-size-small gem-button-type-on-surface lm-enabled ng-star-inserted" _nghost-ng-c3971949594="" aria-describedby="cdk-describedby-message-ng-1-45" cdk-describedby-host="ng-1"><!----><!----><button _ngcontent-ng-c3971949594="" matbadgeposition="after" maticonbutton="" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-badge mat-unthemed mat-badge-overlap mat-badge-above mat-badge-after mat-badge-small mat-badge-hidden ng-star-inserted" mat-ripple-loader-uninitialized="" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" aria-label="Download code" jslog="305704;track:generic_click,impression" aria-disabled="false"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><gem-icon _ngcontent-ng-c3971949594="" _nghost-ng-c2757884704=""><mat-icon _ngcontent-ng-c2757884704="" role="img" class="mat-icon notranslate lm-icon-l lumi-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="arrow_circle_down" data-mat-icon-namespace="lumi-symbols" fonticon="arrow_circle_down"></mat-icon><!----><!----><!----></gem-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----><!----></gem-icon-button><!----><!----><!----><!----><!----><gem-icon-button _ngcontent-ng-c2260553123="" type="onSurface" size="small" fonticonname="copy" theme="lm" arialabel="Copy code" gemtooltip="Copy code" data-test-id="gem-copy-button" class="mat-mdc-tooltip-trigger copy-button ng-tns-c2260553123-102 gem-button gem-button-badge-size-small gem-button-size-small gem-button-type-on-surface lm-enabled ng-star-inserted" _nghost-ng-c3971949594="" aria-describedby="cdk-describedby-message-ng-1-46" cdk-describedby-host="ng-1"><!----><!----><button _ngcontent-ng-c3971949594="" matbadgeposition="after" maticonbutton="" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-badge mat-unthemed mat-badge-overlap mat-badge-above mat-badge-after mat-badge-small mat-badge-hidden ng-star-inserted" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" aria-label="Copy code" jslog="179062;track:generic_click,impression;BardVeMetadataKey:W1sicl8wY2I3NzMwMTIwMDI1ZDBmIiwiY18xNjNhNjhlNzE2NWIxMDY2IixudWxsLCJyY181ZDlkOGFlOThlOWRmNzAzIixudWxsLG51bGwsImZyIixudWxsLDEsbnVsbCxudWxsLDEsMF1d;mutable:true" aria-disabled="false"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><gem-icon _ngcontent-ng-c3971949594="" _nghost-ng-c2757884704=""><mat-icon _ngcontent-ng-c2757884704="" role="img" class="mat-icon notranslate lm-icon-l lumi-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="copy" data-mat-icon-namespace="lumi-symbols" fonticon="copy"></mat-icon><!----><!----><!----></gem-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span><span class="mat-ripple mat-mdc-button-ripple"></span></button><!----><!----></gem-icon-button><!----><!----><!----><!----></div><!----><!----></div><!----><pre _ngcontent-ng-c2260553123="" class="ng-tns-c2260553123-102"><code _ngcontent-ng-c2260553123="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2260553123-102"><span class="hljs-keyword">const</span> weaponModelPaths = {
    <span class="hljs-attr">barre_fer</span>: <span class="hljs-string">"models/crowbar.glb"</span>,
    <span class="hljs-attr">pistolet_9mm</span>: <span class="hljs-string">"models/pistol.glb"</span>,
    <span class="hljs-attr">revolver_357</span>: <span class="hljs-string">"models/revolver.glb"</span>,
    <span class="hljs-attr">fusil_pompe</span>: <span class="hljs-string">"models/shotgun.glb"</span>,
    <span class="hljs-attr">pistolet_mitrailleur</span>: <span class="hljs-string">"models/smg.glb"</span>,
    <span class="hljs-attr">fusil_assaut</span>: <span class="hljs-string">"models/assault_rifle.glb"</span>,
    <span class="hljs-attr">fusil_precision</span>: <span class="hljs-string">"models/sniper.glb"</span>,
    <span class="hljs-attr">mitrailleuse_lourde</span>: <span class="hljs-string">"models/heavy_mg.glb"</span>,
    <span class="hljs-attr">lance_roquettes</span>: <span class="hljs-string">"models/rpg.glb"</span>,
    <span class="hljs-attr">grenade</span>: <span class="hljs-string">"models/grenade.glb"</span>
};

<span class="hljs-keyword">const</span> gltfLoader = <span class="hljs-built_in">window</span>.THREE &amp;&amp; THREE.GLTFLoader ? <span class="hljs-keyword">new</span> THREE.GLTFLoader() : <span class="hljs-literal">null</span>;
<span class="hljs-keyword">const</span> loadedModelCache = {};

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">load3DWeaponGLB</span>(<span class="hljs-params">weaponId</span>) </span>{
    <span class="hljs-keyword">if</span> (!weaponGroup3D) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">while</span> (weaponGroup3D.children.length &gt; <span class="hljs-number">0</span>) {
        weaponGroup3D.remove(weaponGroup3D.children[<span class="hljs-number">0</span>]);
    }

    <span class="hljs-keyword">const</span> path = weaponModelPaths[weaponId];
    <span class="hljs-keyword">if</span> (!gltfLoader || !path) {
        build3DWeaponMesh(weaponId); <span class="hljs-comment">// Repli sur le modèle simple</span>
        <span class="hljs-keyword">return</span>;
    }

    <span class="hljs-keyword">if</span> (loadedModelCache[weaponId]) {
        weaponGroup3D.add(loadedModelCache[weaponId].clone());
        <span class="hljs-keyword">return</span>;
    }

    gltfLoader.load(
        path,
        <span class="hljs-function"><span class="hljs-params">gltf</span> =&gt;</span> {
            <span class="hljs-keyword">const</span> model = gltf.scene;
            <span class="hljs-comment">// Normalise automatiquement la taille et l'orientation du modèle téléchargé</span>
            <span class="hljs-keyword">const</span> box = <span class="hljs-keyword">new</span> THREE.Box3().setFromObject(model);
            <span class="hljs-keyword">const</span> size = box.getSize(<span class="hljs-keyword">new</span> THREE.Vector3());
            <span class="hljs-keyword">const</span> maxDim = <span class="hljs-built_in">Math</span>.max(size.x, size.y, size.z) || <span class="hljs-number">1</span>;
            <span class="hljs-keyword">const</span> scale = <span class="hljs-number">0.55</span> / maxDim;
            model.scale.setScalar(scale);

            <span class="hljs-keyword">const</span> center = box.getCenter(<span class="hljs-keyword">new</span> THREE.Vector3());
            model.position.sub(center.multiplyScalar(scale));

            loadedModelCache[weaponId] = model;
            weaponGroup3D.add(model.clone());
        },
        <span class="hljs-literal">undefined</span>,
        <span class="hljs-function">() =&gt;</span> {
            <span class="hljs-comment">// Si le fichier .glb n'est pas encore dans models/, affiche le modèle simple</span>
            build3DWeaponMesh(weaponId);
        }
    );
}
</code></pre><!----></div></div></div><!----><!----><!----></code-block><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></response-element><p dir="ltr" data-path-to-node="2,2,2"><span>Il suffit ensuite d'appeler </span><code data-path-to-node="2,2,2" data-index-in-node="28">load3DWeaponGLB(equippedWeaponId)</code><span> à la place de </span><code data-path-to-node="2,2,2" data-index-in-node="76">build3DWeaponMesh(equippedWeaponId)</code><span> dans </span><code data-path-to-node="2,2,2" data-index-in-node="117">initThreeFPS()</code><span>,</span><span> </span><code data-path-to-node="2,2,2" data-index-in-node="133">startCombatWithRectangles()</code><span> et </span><code data-path-to-node="2,2,2" data-index-in-node="164">syncCombatWeaponView()</code><span>.</span><span> On peut faire exactement la même chose pour charger un modèle </span><code data-path-to-node="2,2,2" data-index-in-node="250">models/fps_hands.glb</code><span> à la place des deux cylindres/boîtes des avant-bras.</span></p></li></ol><p dir="ltr" data-path-to-node="3"><span class="">Voulez-vous qu'on prépare aussi le chargement d'un fichier </span><code data-path-to-node="3" data-index-in-node="59">models/fps_hands.glb</code><span> pour les mains,</span><span> et que je vous donne un petit outil de réglage (position X/Y/Z et rotation) pour caler facilement chaque modèle </span><code data-path-to-node="3" data-index-in-node="208">.glb</code><span> téléchargé dans les mains ?</span></p></div><!----></message-content><!----><!----></div></structured-content-container><!----><!----></div><!----><!----></model-response-content><!----><!----><!----><!----><div _ngcontent-ng-c1028177799="" class="response-footer gap complete"><!----><!----><!----><sources-list _ngcontent-ng-c1028177799="" class="sources-list ng-star-inserted"><!----></sources-list><!----><!----><election-info-disclaimer _ngcontent-ng-c1028177799="" _nghost-ng-c3304081241="" class="ng-star-inserted" style="display: none;"><!----></election-info-disclaimer><finance-info-disclaimer _ngcontent-ng-c1028177799="" _nghost-ng-c2433247864="" class="ng-star-inserted" style="display: none;"><!----></finance-info-disclaimer><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----><!----></div></div><!----><!----><sensitive-memories-banner _ngcontent-ng-c1028177799="" _nghost-ng-c861928794="" class="ng-star-inserted" style=""><!----></sensitive-memories-banner><!----><!----><!----><!----><!----><!----></div></div><div _ngcontent-ng-c1361134428="" class="response-container-footer ng-tns-c1361134428-100 ng-star-inserted"><!----><!----><!----><message-actions _ngcontent-ng-c1028177799="" footer="" class="hide-on-print ng-tns-c2913108045-103 ng-star-inserted" _nghost-ng-c2913108045="" style=""><div _ngcontent-ng-c2913108045="" class="actions-container-v2 ng-tns-c2913108045-103"><div _ngcontent-ng-c2913108045="" class="buttons-container-v2 ng-tns-c2913108045-103 ng-star-inserted"><!----><thumb-up-button _ngcontent-ng-c2913108045="" _nghost-ng-c1169153851="" class="ng-tns-c2913108045-103 luminous-theme ng-star-inserted"><gem-icon-button _ngcontent-ng-c1169153851="" theme="lm" type="onSurface" arialabel="Good response" gemtooltip="Good response" data-test-id="thumb-up-button" class="mat-mdc-tooltip-trigger gem-button gem-button-badge-size-small gem-button-size-small gem-button-type-on-surface lm-enabled ng-star-inserted" _nghost-ng-c39719