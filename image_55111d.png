endar\\\",\\\"google_calendar_2\\\",\\\"google_chat\\\",\\\"google_keep\\\",\\\"google_reminders\\\",\\\"keep\\\",\\\"reminder\\\",\\\"workspace_tool\\\"]]\",\"45734709\":true,\"45898396\":false,\"45827963\":false,\"45668341\":true,\"45880340\":true,\"45691968\":false,\"45822818\":false,\"45863682\":true,\"45639427\":true,\"45618951\":true,\"45830516\":false,\"45870442\":false,\"45765218\":true,\"45877685\":false,\"45874274\":false,\"45777711\":true,\"45678082\":false,\"45783001\":false,\"45755812\":true,\"45697017\":0,\"45824345\":true,\"45765464\":true,\"45711658\":true,\"45880821\":false,\"45428774\":100,\"45881025\":false,\"45766722\":true,\"45693595\":true,\"45684537\":true,\"45885795\":false,\"45776216\":true,\"45718365\":\"gemini_ail_upsell_model_limit\",\"45882121\":2000,\"45758612\":false,\"45630518\":true,\"45750293\":false,\"45768768\":false,\"45891247\":false,\"45827439\":true,\"45689501\":\"https://github.com/apps/google-integrations/installations/new\",\"45841864\":true,\"45686189\":true,\"45658643\":false,\"45429005\":false,\"45731973\":3,\"45640656\":true,\"45828719\":false,\"45745944\":true,\"45739201\":false,\"45807782\":false,\"45430373\":false,\"45818800\":false,\"45733279\":false,\"45855948\":false,\"45777065\":true,\"45787159\":true,\"45813822\":true,\"45619148\":false,\"45840379\":false,\"45428832\":false,\"45800987\":30000,\"45859067\":4,\"45758421\":true,\"45722012\":true,\"45681677\":true,\"45824508\":true,\"45622144\":true,\"45615223\":\"21.99\",\"45859065\":true,\"45641042\":true,\"45699039\":false,\"45898934\":false,\"45870595\":true,\"45696673\":false,\"45887264\":true,\"45717900\":true,\"45753585\":true,\"45689251\":true,\"45793623\":true,\"45799980\":false,\"45648846\":true,\"45824442\":true,\"45724017\":true,\"45842462\":0,\"45872260\":false,\"45880045\":false,\"45747382\":false,\"45714899\":30,\"45833684\":true,\"45874228\":false,\"45772654\":true,\"45839429\":false,\"45747532\":false,\"45859570\":false,\"45711464\":true,\"45737733\":false,\"45644859\":true,\"45823793\":false,\"45827719\":true,\"45818292\":false,\"45792002\":false,\"45680307\":true,\"45711475\":true,\"45647035\":true,\"45791896\":true,\"45786084\":false,\"45748549\":false,\"45429009\":true,\"45711465\":false,\"45863067\":true,\"45691455\":true,\"45798291\":false,\"45813230\":true,\"45644186\":true,\"45679795\":\"[[\\\"9c17b1863f581b8a\\\",\\\"933eaa010f672fd8\\\",\\\"7ca48d02d802f20a\\\"]]\",\"45644695\":true,\"45872726\":true,\"45683866\":true,\"45733286\":\"[]\",\"45822098\":true,\"45643438\":true,\"45837167\":true,\"45855518\":false,\"45688032\":\"[[\\\"ttlt7zuoalji1b35\\\"]]\",\"45710362\":false,\"45755594\":false,\"45760689\":true,\"45687231\":7000,\"45738810\":true,\"45736266\":true,\"45783408\":false,\"45824137\":true,\"45692025\":true,\"45428786\":true,\"45781763\":true,\"45615771\":\"25A-jj61z7w\",\"45722082\":false,\"45625498\":false,\"45848980\":false,\"45756589\":104857600,\"45886369\":false,\"45759480\":false,\"45747838\":1743526400,\"45792978\":false,\"45830514\":true,\"45745033\":false,\"45726980\":true,\"45883305\":false,\"45683943\":true,\"45876777\":false,\"45753980\":true,\"45813621\":5000,\"45799109\":false,\"45745391\":0,\"45681182\":true,\"45698709\":false,\"45622043\":true,\"45786655\":true,\"45642250\":true,\"45655171\":true,\"45688966\":true,\"45428770\":true,\"45428959\":true,\"45810459\":false,\"45897224\":false,\"45685743\":true,\"45654742\":true,\"45871963\":true,\"45842543\":false,\"45827370\":0,\"45882981\":false,\"45847922\":800,\"45697416\":false,\"45872212\":false,\"106118758\":true,\"45719400\":100,\"45752243\":false,\"45650214\":true,\"45721836\":true,\"45862319\":false,\"45428920\":true,\"45693456\":true,\"45613712\":true,\"45620714\":true,\"45847623\":false,\"45781675\":true,\"45745682\":true,\"45803631\":true,\"45861221\":false,\"45675121\":false,\"45759339\":true,\"45718928\":false,\"45618044\":true,\"45634549\":true,\"45718749\":100,\"45792003\":false,\"45759311\":true,\"45811886\":true,\"45816147\":true,\"45762744\":false,\"45895428\":false,\"45532085\":true,\"45840163\":false,\"45726287\":false,\"45804111\":false,\"45752281\":false,\"45729160\":true,\"45742601\":false,\"45747613\":\"2025-04-01\",\"45884472\":false,\"45836710\":14,\"45726291\":true,\"45783831\":true,\"45770350\":20,\"45767936\":false,\"45690947\":50,\"45726731\":true,\"45670035\":true,\"45856531\":false,\"45692510\":false,\"45845469\":true,\"45828864\":false,\"45681005\":50,\"45642397\":false,\"45702980\":true,\"45689609\":\"[]\",\"45797901\":false,\"45857980\":false,\"45728197\":true,\"45813205\":false,\"45731385\":false,\"45724929\":true,\"45836246\":\"\",\"45811348\":true,\"45857988\":false,\"45828384\":false,\"45747329\":true,\"45632647\":true,\"45716789\":true,\"45748667\":\"[[\\\"5bf011840784117a\\\",\\\"e051ce1aa80aa576\\\",\\\"b11155c88d2cdac8\\\"]]\",\"45758969\":true,\"45835457\":false,\"45747802\":true,\"45743311\":true,\"45727588\":\"[]\",\"45818004\":false,\"45698757\":true,\"45885797\":false,\"45532353\":true,\"45820651\":\"[[\\\"monday-connector-prod\\\",\\\"4295235d-8c9d-42de-9add-d125d54d7491-mcp-evernote-com\\\",\\\"f5e83368-0659-407a-98a6-2100a0586080-mcp-pandadoc-com\\\",\\\"shopify-connector-prod\\\",\\\"target.com\\\"]]\",\"45428801\":\"A\",\"45630970\":true,\"45654883\":false,\"45885710\":false,\"45655382\":true,\"45678004\":false,\"45870593\":true,\"45807846\":true,\"45764975\":false,\"45707257\":false,\"45773788\":true,\"45869560\":true,\"45428812\":false,\"45681648\":false,\"45630517\":true,\"45864611\":false,\"45840780\":false,\"45768409\":false,\"45690847\":\"\",\"45727701\":true,\"45680680\":true,\"45642259\":true,\"45764650\":false,\"45823762\":false,\"45649882\":true,\"45755013\":true,\"45768315\":false,\"45865879\":false,\"45862080\":true,\"45700634\":270,\"45707063\":true,\"45733280\":false,\"45676455\":true,\"45855603\":true,\"45735500\":true,\"45752369\":true,\"45837313\":false,\"45708712\":false,\"45845259\":true,\"45849940\":false,\"45719771\":false,\"45719064\":false,\"45428988\":30000,\"45812723\":true,\"45864641\":false,\"45716325\":true,\"45756588\":2147483648,\"45676406\":\"comment-tag\",\"45813600\":true,\"45696889\":true,\"45807551\":\"# Goal:\\nGenerate a personalized, styled topic response based on a user\u0027s recurring interests. Based on the raw data provided at the bottom, you would generate a response following the rules below. Only ground the response on the data provided in the context. Do not search online or add additional information.\\n\\n### Step 1: Format the Main User-Facing Response\\n1.  **Identify the latest state of the Topic:** Look through the topic context to identify its latest state, including the user\u0027s overarching goal, key decisions, key things that have happened, where the user is in their journey, what are potential next steps users might want to take. Make use of this information to generate the follow components together (bullet 2-4 below)\\n2.  **Greeting**: Based on bullet 1 above, start with a 1-sentence brief greeting or question from Gemini using the # header to invite the user to engage with this topic. Pick the greeting style that best fits the current moment from the options below.\\n\\n      **Critical: Vary your phrasing.** Do not start greetings the same way repeatedly. Mix up your sentence structure — use questions, statements, exclamations, or fragments. Avoid defaulting to the same opening words.\\n\\n      Do NOT overuse these starter patterns:\\n        × \\\"Ready to...\\\"\\n        × \\\"Let\u0027s...\\\"\\n        × \\\"Time to...\\\"\\n        × \\\"Looking to...\\\"\\n        × \\\"Want to...\\\"\\n        × \\\"How about...\\\"\\n\\n      **Greeting granularity:** Keep greetings at the right level of abstraction. Reference the topic\u0027s emotional core or current momentum — not hyper-specific details like part numbers, exact dates, or item specs. Save those for the Latest State Summary.\\n\\n      Greeting styles and example phrasings (use these as inspiration, not templates):\\n\\n        a) **Thoughtful check-in** — when the journey is ongoing without a major recent event:\\n           - \\\"How\u0027s [topic] coming along?\\\"\\n           - \\\"Checking in — any updates on [topic]?\\\"\\n           - \\\"What\u0027s the latest with [topic]?\\\"\\n           - \\\"Still feeling good about [direction/decision]?\\\"\\n           - \\\"[Topic] has been on your mind — where do things stand?\\\"\\n\\n        b) **Progress celebration** — when the user hit a milestone, made a decision, or completed a step:\\n           - \\\"That\u0027s a big one — [milestone] is done!\\\"\\n           - \\\"Look at that, [achievement]!\\\"\\n           - \\\"[Decision] was a solid call.\\\"\\n           - \\\"You\u0027ve been putting in the work on [topic] — it shows.\\\"\\n           - \\\"Major progress — [thing] is officially behind you.\\\"\\n\\n        c) **Reflection prompt** — when the user has been on a longer journey and it\u0027s a good moment to step back:\\n           - \\\"It\u0027s been a few weeks with [topic] — how\u0027s it feeling?\\\"\\n           - \\\"A lot has happened with [topic] — worth a quick look back?\\\"\\n           - \\\"You\u0027ve come a long way on this one.\\\"\\n           - \\\"Funny how much [topic] has evolved since you started.\\\"\\n\\n        d) **Callback to a specific detail** — when the context has a memorable, personal detail worth referencing:\\n           - \\\"Curious how [detail from context] played out.\\\"\\n           - \\\"You were weighing [option A vs B] — any verdict?\\\"\\n           - \\\"That [memorable moment] must have been something.\\\"\\n\\n           Avoid framing callbacks as yes/no questions (e.g., \\\"Did X happen?\\\"). Instead, use open-ended references that invite the user to share, not just confirm.\\n\\n           This style works best when the detail is central to the topic or represents a key decision point. Don\u0027t use it to surface a random anecdote from a broad, ongoing topic. Also avoid referencing negative incidents or naming other people (partners, family) in the greeting.\\n\\n        e) **Invitation to continue** — when there\u0027s clear unfinished work from a previous session:\\n           - \\\"You left off right at [specific point] — pick it up?\\\"\\n           - \\\"[Unfinished step] is here whenever you\u0027re ready.\\\"\\n           - \\\"There\u0027s a fun decision still waiting on [topic].\\\"\\n           - \\\"Picking up from last time — [context].\\\"\\n\\n           Frame unfinished work as an opportunity, not a backlog. The tone should feel like \\\"here\u0027s something interesting to come back to\\\" — not a task reminder.\\n\\n        f) **Anticipation builder** — when something exciting or important is coming up:\\n           - \\\"[Event] is right around the corner!\\\"\\n           - \\\"Only [X days] until [event] — exciting stuff.\\\"\\n           - \\\"The countdown is on for [event].\\\"\\n           - \\\"[Event] is getting close — feeling prepared?\\\"\\n           - \\\"Big day coming up with [event]!\\\"\\n\\n        g) **Gentle nudge** — when the user has been away for a while:\\n           - \\\"Been a little while — [topic] is still here for you.\\\"\\n           - \\\"Hey, [topic] hasn\u0027t gone anywhere.\\\"\\n           - \\\"It\u0027s been a bit — anything new on [topic]?\\\"\\n           - \\\"Whenever you want to jump back into [topic].\\\"\\n\\n        h) **Curiosity spark** — when there\u0027s a new angle or idea the user hasn\u0027t explored:\\n           - \\\"Have you thought about [new angle]?\\\"\\n           - \\\"Here\u0027s something you might not have considered for [topic].\\\"\\n           - \\\"There might be another way to approach [aspect].\\\"\\n           - \\\"One thing that could help with [topic]: [idea].\\\"\\n\\n        i) **Empathetic acknowledgment** — when the topic involves stress, complexity, or emotional weight:\\n           - \\\"The [specific challenge] hasn\u0027t been easy — but you\u0027re in it.\\\"\\n           - \\\"You\u0027ve been doing real work understanding [specific insight the user reached].\\\"\\n           - \\\"Navigating [topic] takes patience — and you\u0027ve got it.\\\"\\n\\n           Keep empathetic greetings short — one specific anchor, not a list of stressors. Reference the user\u0027s own language or breakthroughs when possible (e.g., a framework they named, a pattern they identified). Vague validation like \\\"you\u0027ve got a lot going on\\\" doesn\u0027t land — show you know *what*.\\n\\n        j) **Low-pressure opener** — when the topic is casual or the user might feel guilty about not engaging:\\n           - \\\"No rush on this one — [topic] is here when you need it.\\\"\\n           - \\\"Just keeping [topic] warm for you.\\\"\\n           - \\\"[Topic] is simmering in the background.\\\"\\n           - \\\"Nothing urgent — just your [topic] notes, whenever.\\\"\\n\\n3.  **Latest State Summary**: Based on the content in bullet 1 \u0026 2 above, provide a 1-2 sentence summary of the latest state of the topic. The \\\"Greeting\\\" and \\\"Latest State Summary\\\" should flow naturally. Prioritize recent developments and where the user left off, making it easy for them to pick things up. Keep it concise and do not regurgitate the whole context.\\n4.  **[Optional] Suggested Next Steps**: Look through the context and the content from bullet 1-3 above, especially the user\u0027s current goals, think about if there\u0027s anything the user could do now to advance on their goal. Not all topics will have obvious next steps - next steps could exist because the user left in the middle of their task earlier, something new happened while they\u0027re away, or something that could benefit their goal, but they haven\u0027t thought about yet. Only provide this section when you find reasonable next steps. Otherwise, skip this section.\\n      - If it is unclear whether a suggestion will be helpful due to missing (e.g. unconfirmed current state) or conflicting information (e.g. part of the context states that the user needs something, but some other facts within the context contradicts it), do not include it. It\u0027s perfectly fine to only have 0, 1 or 2 suggestions.\\n      - If suggestions are available, put them under the section header ## Suggested next steps, in bullet points\\n      - Make them actionable and contextually-relevant.\\n      - Only offer suggestions that you, Gemini, are capable of helping them on.\\n      - Keep each suggestion around 75 characters max. Keep a natural tone, and avoid being robotic.\\n      - Start every suggestion with an action verb (e.g., \\\"Review,\\\" \\\"Compare,\\\" \\\"Draft,\\\" \\\"Walk through,\\\" \\\"Prepare,\\\" \\\"Find,\\\" \\\"Identify\\\"). The suggestion should make clear what Gemini will deliver when tapped.\\n      - Frame suggestions as things Gemini can deliver, not real-world tasks the user must do themselves (e.g., \\\"Draft a reminder for the vet call\\\" not \\\"Call the vet\\\").\\n      - Make sure to consider the temporal relevance of your suggestions - if the user has likely already finished something (as time passes by in the real world), do not suggest that.\\n5.  **Spacing**: After the suggestions, include 5 empty rows (using empty lines or HTML \u003cbr\u003e tags/non-breaking spaces to ensure visual separation in the output).\\n\\n### Step 2: Format the Topic Memory Code Block\\nDirectly below the spacing, insert a single markdown code block containing the structured topic memory:\\n1.  **Title and Description**: Inside the code block, write:\\n```\\n\\nTopic memory\\n\\nAll the content below won\u0027t be shown on the Topics Zero State.\\nThey will be used in responses, and will be 1 tap away if the user\\nwants to take a deeper look at the Topic\u0027s memory.\\n\\n```\\n2.  **Organized Context**: Organize all context provided for the interest inside the code block as a comprehensive view of the topic\u0027s memory. The goal of this part of the UI is similar to great meeting notes taken by expert notetakers - capture all the relevant information without missing anything, and format them into sections that are easy to digest.\\n  - Be comprehensive; do not lose any information originally shared. Only modify things stylistically, while trying to keep the content the same as is. Avoid adding any interpretations.\\n  - Format it to be easy to glance.\\n  - Divide into meaningful sections and subsections with emojis for section titles.\\n  - Wrap lines manually so users can view all the text within the code block at a glance without horizontal scrolling.\\n3.  **Relevant Conversations**: Extract the `conversation_ids` from the raw data. For each ID, remove the `c_` prefix if it exists. Format the ID as a plain text link: `https://gemini.google.com/app/\u003cid_without_prefix\u003e`. Group these links under a header named \\\"💬 Relevant Conversations\\\" inside the code block.\\n\\n### Step 3: Handle Subsequent Turns\\n  - For normal follow-up questions in the same chat, respond normally. Personalize your response with the context from the first turn\u0027s response when relevant. However, do NOT follow the instructions to format the response as above - so no greeting, summary, suggestions, or code blocks in subsequent turns. Only use the topic context as additional context and respond in normal response formats.\\n  - If the user directly asks you to change the scope of the topic, or issue any corrections because the topic content is wrong\\n      - First use body text to acknowledge the change, and let users see the updated topic home page content below.\\n      - Then, follow the user\u0027s instructions to modify the context, and then re-generate the first turn\u0027s response (Greeting, Summary, Suggested next steps, spacing, and Topic memory code block) using the updated context.\\n      - Limit the acknowledgement to the first sentence at the top. The greeting \u0026 summary below should not be a direct response to acknowledge the change. It should just directly show the updated greeting / summary / suggestions / codeblock, as if you had this correct information in the first turn.\\n      - This should be the only case after the 1st turn where you follow the format above to regenerate the greeting, summary, suggestions, and code block.\",\"45664203\":true,\"45625458\":true,\"45702598\":false,\"45786168\":true,\"45704298\":false,\"45845716\":true,\"45766938\":false,\"45805086\":\"\",\"45816870\":true,\"45718445\":false,\"45725872\":false,\"45779300\":true,\"45884449\":false,\"45781255\":\"\",\"45746302\":true,\"45771904\":true,\"45727630\":false,\"45637468\":true,\"45845728\":false,\"45765847\":1,\"45785781\":true,\"45754172\":true,\"45861036\":false,\"45776085\":true,\"45868063\":false,\"45428992\":false,\"45646986\":false,\"45758784\":true,\"45615023\":\"ease-out\",\"45782803\":true,\"45816333\":true,\"45706580\":false,\"45677808\":true,\"45629789\":400,\"45791916\":true,\"45718323\":false,\"45837719\":false,\"45658689\":true,\"45693810\":false,\"45704448\":true,\"45713311\":true,\"45649949\":false,\"45701713\":true,\"45861815\":false,\"45861816\":false,\"45692433\":true,\"45847921\":150,\"45708465\":true,\"45831738\":true,\"45879263\":false,\"45769114\":false,\"45846851\":\"release\",\"45737518\":\"9d8ca3786ebdfbea\",\"45887358\":false,\"45799735\":false,\"45728348\":true,\"45831229\":false,\"45687097\":true,\"45776899\":true,\"45704526\":false,\"45700300\":false,\"45687419\":true,\"45847257\":true,\"45844276\":false,\"45870856\":false,\"45615457\":\"€\",\"45894807\":false,\"45766477\":true,\"45854971\":true,\"45760769\":false,\"45720836\":false,\"45644209\":true,\"45811652\":true,\"45738845\":\"Gemini 3 Pro\",\"45776006\":0,\"45619796\":true,\"45726702\":true,\"45688943\":\"RESEARCH_TRAVEL◊◊RESEARCH_LIFESTYLE◊◊RESEARCH_GROWTH◊◊RESEARCH_SHOPPING◊◊RESEARCH_LEARNING◊◊