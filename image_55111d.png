    <span class="hljs-keyword">if</span> (!renderer3D || !scene3D || !camera3D || !rigRoot3D) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">if</span> (!inCombat || isPaused) {
        renderer3D.render(scene3D, camera3D);
        <span class="hljs-keyword">return</span>;
    }

    <span class="hljs-keyword">const</span> moving = activeMoveKeys.z || activeMoveKeys.q || activeMoveKeys.s || activeMoveKeys.d;
    walkBobTime3D += moving ? <span class="hljs-number">0.14</span> : <span class="hljs-number">0.03</span>;

    <span class="hljs-keyword">const</span> bobAmp = moving ? <span class="hljs-number">0.022</span> : <span class="hljs-number">0.005</span>;
    <span class="hljs-keyword">const</span> bobX = <span class="hljs-built_in">Math</span>.cos(walkBobTime3D) * bobAmp;
    <span class="hljs-keyword">const</span> bobY = <span class="hljs-built_in">Math</span>.abs(<span class="hljs-built_in">Math</span>.sin(walkBobTime3D)) * bobAmp;

    recoilOffset3D *= <span class="hljs-number">0.82</span>;
    recoilPitch3D *= <span class="hljs-number">0.82</span>;

    <span class="hljs-keyword">if</span> (isReloading) {
