    } <span class="hljs-keyword">else</span> {
        reloadAnim3D = <span class="hljs-built_in">Math</span>.max(<span class="hljs-number">0</span>, reloadAnim3D - <span class="hljs-number">0.12</span>);
    }

    rigRoot3D.position.x = bobX - lookYaw * <span class="hljs-number">0.0022</span>;
    rigRoot3D.position.y = -<span class="hljs-number">0.42</span> - bobY - reloadAnim3D * <span class="hljs-number">0.18</span> - lookPitch * <span class="hljs-number">0.0016</span>;
    rigRoot3D.position.z = <span class="hljs-number">0.75</span> + recoilOffset3D;

    rigRoot3D.rotation.x = recoilPitch3D - reloadAnim3D * <span class="hljs-number">0.45</span> - lookPitch * <span class="hljs-number">0.004</span>;
    rigRoot3D.rotation.y = -lookYaw * <span class="hljs-number">0.005</span>;
    rigRoot3D.rotation.z = reloadAnim3D * <span class="hljs-number">0.22</span>;

    renderer3D.render(scene3D, camera3D);
}

