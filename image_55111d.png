                    Cliquez sur une arme pour voir les statistiques actuelles (à gauche) et après amélioration (à droite).
                <span class="hljs-tag">&lt;/<span class="hljs-name">div</span>&gt;</span>
                <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">id</span>=<span class="hljs-string">"compare-boxes"</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"compare-boxes hidden"</span>&gt;</span>
                    <span class="hljs-tag">&lt;<span class="hljs-name">div</span> <span class="hljs-attr">class</span>=<span class="hljs-string">"compare-card current-card"</span>&gt;</span>
                        <span class="hljs-tag">&lt;<span class="hljs-name">h3</span>&gt;</span>STATISTIQUES ACTUELLES<span class="hljs-tag">&lt;/<span class="hljs-name">h3</span>&gt;</span>
