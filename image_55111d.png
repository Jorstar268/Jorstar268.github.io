utton-size-small gem-button-type-on-surface lm-enabled ng-star-inserted" _nghost-ng-c3971949594="" aria-describedby="cdk-describedby-message-ng-1-46" cdk-describedby-host="ng-1"><!----><!----><button _ngcontent-ng-c3971949594="" matbadgeposition="after" maticonbutton="" class="mdc-icon-button mat-mdc-icon-button mat-mdc-button-base mat-badge mat-unthemed mat-badge-overlap mat-badge-above mat-badge-after mat-badge-small mat-badge-hidden ng-star-inserted" mat-ripple-loader-class-name="mat-mdc-button-ripple" mat-ripple-loader-centered="" aria-label="Copy code" jslog="179062;track:generic_click,impression;BardVeMetadataKey:W1sicl80ZWQ1ZmUwOTY1ODE3YWI4IiwiY18xNjNhNjhlNzE2NWIxMDY2IixudWxsLCJyY184Y2Q0OTA2ZWFlZjlkMGQ4IixudWxsLG51bGwsImZyIixudWxsLDEsbnVsbCxudWxsLDEsMF1d;mutable:true" aria-disabled="false"><span class="mat-mdc-button-persistent-ripple mdc-icon-button__ripple"></span><gem-icon _ngcontent-ng-c3971949594="" _nghost-ng-c2757884704=""><mat-icon _ngcontent-ng-c2757884704="" role="img" class="mat-icon notranslate lm-icon-l lumi-symbols mat-ligature-font mat-icon-no-color ng-star-inserted" aria-hidden="true" data-mat-icon-type="font" data-mat-icon-name="copy" data-mat-icon-namespace="lumi-symbols" fonticon="copy"></mat-icon><!----><!----><!----></gem-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span><span class="mat-ripple mat-mdc-button-ripple"></span></button><!----><!----></gem-icon-button><!----><!----><!----><!----></div><!----><!----></div><!----><pre _ngcontent-ng-c2260553123="" class="ng-tns-c2260553123-29"><code _ngcontent-ng-c2260553123="" role="text" data-test-id="code-content" class="code-container formatted ng-tns-c2260553123-29"><span class="hljs-keyword">const</span> title = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"main-title"</span>);
<span class="hljs-keyword">const</span> blackScreen = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"black-screen"</span>);
<span class="hljs-keyword">const</span> bgBlood = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"bg-blood"</span>);

<span class="hljs-comment">// 1. Découpe automatiquement le texte du titre en lettres individuelles</span>
<span class="hljs-keyword">const</span> text = title.textContent;
title.textContent = <span class="hljs-string">""</span>;

<span class="hljs-keyword">const</span> letters = [];
<span class="hljs-keyword">for</span> (<span class="hljs-keyword">let</span> i = <span class="hljs-number">0</span>; i &lt; text.length; i++) {
    <span class="hljs-keyword">const</span> span = <span class="hljs-built_in">document</span>.createElement(<span class="hljs-string">"span"</span>);
    span.textContent = text[i] === <span class="hljs-string">" "</span> ? <span class="hljs-string">"\u00A0"</span> : text[i];
    span.classList.add(<span class="hljs-string">"letter"</span>);

    <span class="hljs-keyword">if</span> (i &lt; text.length / <span class="hljs-number">2</span>) {
        span.classList.add(<span class="hljs-string">"go-left"</span>);
    } <span class="hljs-keyword">else</span> {
        span.classList.add(<span class="hljs-string">"go-right"</span>);
    }

    title.appendChild(span);
    letters.push(span);
}

<span class="hljs-comment">// 2. Déclenchement de la séquence au clic sur le titre</span>
<span class="hljs-keyword">let</span> isTriggered = <span class="hljs-literal">false</span>;

title.addEventListener(<span class="hljs-string">"click"</span>, <span class="hljs-function">() =&gt;</span> {
    <span class="hljs-keyword">if</span> (isTriggered) <span class="hljs-keyword">return</span>;
    isTriggered = <span class="hljs-literal">true</span>;

    title.classList.add(<span class="hljs-string">"animating"</span>);

    letters.forEach(<span class="hljs-function">(<span class="hljs-params">letter, index</span>) =&gt;</span> {
        <span class="hljs-keyword">if</span> (index &lt; letters.length / <span class="hljs-number">2</span>) {
            letter.classList.add(<span class="hljs-string">"shoot-left"</span>);
        } <span class="hljs-keyword">else</span> {
            letter.classList.add(<span class="hljs-string">"shoot-right"</span>);
        }
    });

    <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">() =&gt;</span> {
        title.classList.add(<span class="hljs-string">"finished"</span>);
        blackScreen.style.opacity = <span class="hljs-string">"1"</span>;
    }, <span class="hljs-number">700</span>);

    <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">() =&gt;</span> {
        bgBlood.style.opacity = <span class="hljs-string">"1"</span>;
        blackScreen.style.opacity = <span class="hljs-string">"0"</span>;

        <span class="hljs-built_in">setTimeout</span>(<span class="hljs-function">() =&gt;</span> {
            <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"side-menu"</span>).classList.remove(<span class="hljs-string">"hidden"</span>);
        }, <span class="hljs-number">400</span>);
    }, <span class="hljs-number">1300</span>);
});

