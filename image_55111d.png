    <span class="hljs-attribute">background</span>: <span class="hljs-built_in">radial-gradient</span>(circle at center, <span class="hljs-built_in">rgba</span>(<span class="hljs-number">22</span>, <span class="hljs-number">48</span>, <span class="hljs-number">36</span>, <span class="hljs-number">0.42</span>) <span class="hljs-number">0%</span>, <span class="hljs-built_in">rgba</span>(<span class="hljs-number">5</span>, <span class="hljs-number">11</span>, <span class="hljs-number">24</span>, <span class="hljs-number">0.86</span>) <span class="hljs-number">100%</span>);
    <span class="hljs-attribute">font-family</span>: sans-serif;
    <span class="hljs-attribute">color</span>: <span class="hljs-number">#e8f5e9</span>;
    user-select: none;
}

<span class="hljs-selector-id">#combat-view-layer</span> {
