<span class="hljs-comment">// --- TRANSITION 20 RECTANGLES, COMBAT 3D &amp; PAUSE / ZOMBIES ---</span>
<span class="hljs-comment">// =========================================================</span>

<span class="hljs-keyword">const</span> transitionGrid = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"transition-grid"</span>);
<span class="hljs-keyword">const</span> combatScreen = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"combat-screen"</span>);
<span class="hljs-keyword">const</span> combatViewLayer = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"combat-view-layer"</span>);
<span class="hljs-keyword">const</span> fps3dWrap = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"fps-3d-wrap"</span>);
<span class="hljs-keyword">const</span> combatWeaponLabel = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"combat-weapon-label"</span>);
<span class="hljs-keyword">const</span> combatAmmoCounter = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"combat-ammo-counter"</span>);
<span class="hljs-keyword">const</span> combatStatusBadge = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"combat-status-badge"</span>);
<span class="hljs-keyword">const</span> combatEarnedMoneyEl = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"combat-earned-money"</span>);
<span class="hljs-keyword">const</span> healChargesEl = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"heal-charges"</span>);
<span class="hljs-keyword">const</span> playerHpTextEl = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"player-hp-text"</span>);
<span class="hljs-keyword">const</span> playerHpFillEl = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"player-hp-fill"</span>);
<span class="hljs-keyword">const</span> pauseOverlay = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"pause-overlay"</span>);
<span class="hljs-keyword">const</span> zombieTargetBtn = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"zombie-target"</span>);
<span class="hljs-keyword">const</span> zombieHpFill = <span class="hljs-built_in">document</span>.getElementById(<span class="hljs-string">"zombie-hp-fill"</span>);

<span class="hljs-keyword">let</span> inCombat = <span class="hljs-literal">false</span>;
<span class="hljs-keyword">let</span> isPaused = <span class="hljs-literal">false</span>;
<span class="hljs-keyword">let</span> isReloading = <span class="hljs-literal">false</span>;
<span class="hljs-keyword">let</span> earnedInMatch = <span class="hljs-number">0</span>;
<span class="hljs-keyword">let</span> healCharges = <span class="hljs-number">3</span>;
<span class="hljs-keyword">let</span> playerMaxHp = <span class="hljs-number">100</span>;
<span class="hljs-keyword">let</span> playerHp = <span class="hljs-number">100</span>;
<span class="hljs-keyword">let</span> currentWave = <span class="hljs-number">1</span>;
<span class="hljs-keyword">const</span> totalWaves = <span class="hljs-number">5</span>;
<span class="hljs-keyword">let</span> lookYaw = <span class="hljs-number">0</span>;
<span class="hljs-keyword">let</span> lookPitch = <span class="hljs-number">0</span>;
<span class="hljs-keyword">let</span> activeDifficulty = <span class="hljs-literal">null</span>;

<span class="hljs-keyword">let</span> ammoByWeaponId = {};
<span class="hljs-keyword">let</span> zombieMaxHp = <span class="hljs-number">60</span>;
<span class="hljs-keyword">let</span> zombieHp = <span class="hljs-number">60</span>;

<span class="hljs-comment">// --- MOTEUR 3D (THREE.JS) : MAINS + ARMES ---</span>
<span class="hljs-keyword">let</span> scene3D = <span class="hljs-literal">null</span>;
<span class="hljs-keyword">let</span> camera3D = <span class="hljs-literal">null</span>;
<span class="hljs-keyword">let</span> renderer3D = <span class="hljs-literal">null</span>;
<span class="hljs-keyword">let</span> rigRoot3D = <span class="hljs-literal">null</span>;
<span class="hljs-keyword">let</span> weaponGroup3D = <span class="hljs-literal">null</span>;
<span class="hljs-keyword">let</span> leftArmGroup3D = <span class="hljs-literal">null</span>;
<span class="hljs-keyword">let</span> rightArmGroup3D = <span class="hljs-literal">null</span>;
<span class="hljs-keyword">let</span> recoilOffset3D = <span class="hljs-number">0</span>;
<span class="hljs-keyword">let</span> recoilPitch3D = <span class="hljs-number">0</span>;
<span class="hljs-keyword">let</span> reloadAnim3D = <span class="hljs-number">0</span>;
<span class="hljs-keyword">let</span> walkBobTime3D = <span class="hljs-number">0</span>;
<span class="hljs-keyword">let</span> activeMoveKeys = { <span class="hljs-attr">z</span>: <span class="hljs-literal">false</span>, <span class="hljs-attr">q</span>: <span class="hljs-literal">false</span>, <span class="hljs-attr">s</span>: <span class="hljs-literal">false</span>, <span class="hljs-attr">d</span>: <span class="hljs-literal">false</span> };

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">initThreeFPS</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">if</span> (!<span class="hljs-built_in">window</span>.THREE || !fps3dWrap || renderer3D) <span class="hljs-keyword">return</span>;

    scene3D = <span class="hljs-keyword">new</span> THREE.Scene();

    <span class="hljs-keyword">const</span> width = fps3dWrap.clientWidth || <span class="hljs-built_in">window</span>.innerWidth;
    <span class="hljs-keyword">const</span> height = fps3dWrap.clientHeight || <span class="hljs-built_in">window</span>.innerHeight;

    camera3D = <span class="hljs-keyword">new</span> THREE.PerspectiveCamera(<span class="hljs-number">65</span>, width / height, <span class="hljs-number">0.05</span>, <span class="hljs-number">50</span>);
    camera3D.position.set(<span class="hljs-number">0</span>, <span class="hljs-number">0</span>, <span class="hljs-number">1.5</span>);

    renderer3D = <span class="hljs-keyword">new</span> THREE.WebGLRenderer({ <span class="hljs-attr">alpha</span>: <span class="hljs-literal">true</span>, <span class="hljs-attr">antialias</span>: <span class="hljs-literal">true</span> });
    renderer3D.setSize(width, height);
    renderer3D.setPixelRatio(<span class="hljs-built_in">Math</span>.min(<span class="hljs-built_in">window</span>.devicePixelRatio || <span class="hljs-number">1</span>, <span class="hljs-number">2</span>));
    fps3dWrap.innerHTML = <span class="hljs-string">""</span>;
    fps3dWrap.appendChild(renderer3D.domElement);

    <span class="hljs-keyword">const</span> ambient = <span class="hljs-keyword">new</span> THREE.AmbientLight(<span class="hljs-number">0xdbeafe</span>, <span class="hljs-number">1.15</span>);
    scene3D.add(ambient);

    <span class="hljs-keyword">const</span> keyLight = <span class="hljs-keyword">new</span> THREE.DirectionalLight(<span class="hljs-number">0xffffff</span>, <span class="hljs-number">1.6</span>);
    keyLight.position.set(<span class="hljs-number">2.5</span>, <span class="hljs-number">4</span>, <span class="hljs-number">3.5</span>);
    scene3D.add(keyLight);

    <span class="hljs-keyword">const</span> rimLight = <span class="hljs-keyword">new</span> THREE.DirectionalLight(<span class="hljs-number">0xff6b6b</span>, <span class="hljs-number">0.7</span>);
    rimLight.position.set(-<span class="hljs-number">3</span>, <span class="hljs-number">1.5</span>, <span class="hljs-number">2</span>);
    scene3D.add(rimLight);

    rigRoot3D = <span class="hljs-keyword">new</span> THREE.Group();
    rigRoot3D.position.set(<span class="hljs-number">0</span>, -<span class="hljs-number">0.42</span>, <span class="hljs-number">0.75</span>);
    scene3D.add(rigRoot3D);

    <span class="hljs-keyword">const</span> sleeveMat = <span class="hljs-keyword">new</span> THREE.MeshStandardMaterial({ <span class="hljs-attr">color</span>: <span class="hljs-number">0x3f4a22</span>, <span class="hljs-attr">roughness</span>: <span class="hljs-number">0.75</span> });
    <span class="hljs-keyword">const</span> gloveMat = <span class="hljs-keyword">new</span> THREE.MeshStandardMaterial({ <span class="hljs-attr">color</span>: <span class="hljs-number">0x6e4726</span>, <span class="hljs-attr">roughness</span>: <span class="hljs-number">0.55</span> });

    leftArmGroup3D = <span class="hljs-keyword">new</span> THREE.Group();
    <span class="hljs-keyword">const</span> leftForearm = <span class="hljs-keyword">new</span> THREE.Mesh(<span class="hljs-keyword">new</span> THREE.CylinderGeometry(<span class="hljs-number">0.065</span>, <span class="hljs-number">0.08</span>, <span class="hljs-number">0.46</span>, <span class="hljs-number">14</span>), sleeveMat);
    leftForearm.rotation.x = <span class="hljs-built_in">Math</span>.PI * <span class="hljs-number">0.42</span>;
    leftForearm.rotation.z = -<span class="hljs-number">0.22</span>;
    leftForearm.position.set(-<span class="hljs-number">0.26</span>, -<span class="hljs-number">0.18</span>, <span class="hljs-number">0.24</span>);
    <span class="hljs-keyword">const</span> leftGlove = <span class="hljs-keyword">new</span> THREE.Mesh(<span class="hljs-keyword">new</span> THREE.BoxGeometry(<span class="hljs-number">0.11</span>, <span class="hljs-number">0.09</span>, <span class="hljs-number">0.13</span>), gloveMat);
    leftGlove.position.set(-<span class="hljs-number">0.19</span>, -<span class="hljs-number">0.09</span>, <span class="hljs-number">0.02</span>);
    leftArmGroup3D.add(leftForearm, leftGlove);

    rightArmGroup3D = <span class="hljs-keyword">new</span> THREE.Group();
    <span class="hljs-keyword">const</span> rightForearm = <span class="hljs-keyword">new</span> THREE.Mesh(<span class="hljs-keyword">new</span> THREE.CylinderGeometry(<span class="hljs-number">0.065</span>, <span class="hljs-number">0.08</span>, <span class="hljs-number">0.46</span>, <span class="hljs-number">14</span>), sleeveMat);
    rightForearm.rotation.x = <span class="hljs-built_in">Math</span>.PI * <span class="hljs-number">0.42</span>;
    rightForearm.rotation.z = <span class="hljs-number">0.22</span>;
    rightForearm.position.set(<span class="hljs-number">0.26</span>, -<span class="hljs-number">0.18</span>, <span class="hljs-number">0.24</span>);
    <span class="hljs-keyword">const</span> rightGlove = <span class="hljs-keyword">new</span> THREE.Mesh(<span class="hljs-keyword">new</span> THREE.BoxGeometry(<span class="hljs-number">0.11</span>, <span class="hljs-number">0.09</span>, <span class="hljs-number">0.13</span>), gloveMat);
    rightGlove.position.set(<span class="hljs-number">0.18</span>, -<span class="hljs-number">0.09</span>, <span class="hljs-number">0.04</span>);
    rightArmGroup3D.add(rightForearm, rightGlove);

    weaponGroup3D = <span class="hljs-keyword">new</span> THREE.Group();
    weaponGroup3D.position.set(<span class="hljs-number">0.08</span>, -<span class="hljs-number">0.04</span>, -<span class="hljs-number">0.08</span>);

    rigRoot3D.add(leftArmGroup3D, rightArmGroup3D, weaponGroup3D);
    build3DWeaponMesh(equippedWeaponId);

    <span class="hljs-built_in">window</span>.addEventListener(<span class="hljs-string">"resize"</span>, handleResize3D);
    animate3DLoop();
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">handleResize3D</span>(<span class="hljs-params"></span>) </span>{
    <span class="hljs-keyword">if</span> (!renderer3D || !camera3D || !fps3dWrap) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">const</span> width = fps3dWrap.clientWidth || <span class="hljs-built_in">window</span>.innerWidth;
    <span class="hljs-keyword">const</span> height = fps3dWrap.clientHeight || <span class="hljs-built_in">window</span>.innerHeight;
    camera3D.aspect = width / height;
    camera3D.updateProjectionMatrix();
    renderer3D.setSize(width, height);
}

<span class="hljs-function"><span class="hljs-keyword">function</span> <span class="hljs-title">build3DWeaponMesh</span>(<span class="hljs-params">weaponId</span>) </span>{
    <span class="hljs-keyword">if</span> (!weaponGroup3D) <span class="hljs-keyword">return</span>;
    <span class="hljs-keyword">while</span> (weaponGroup3D.children.length &gt; <span class="hljs-number">0</span>) {
        weaponGroup3D.remove(weaponGroup3D.children[<span class="hljs-number">0</span>]);
    }

    <span class="hljs-keyword">const</span> darkMetal = <span class="hljs-keyword">new</span> THREE.MeshStandardMaterial({ <span class="hljs-attr">color</span>: <span class="hljs-number">0x222629</span>, <span class="hljs-attr">metalness</span>: <span class="hljs-number">0.75</span>, <span class="hljs-attr">roughness</span>: <span class="hljs-number">0.3</span> });
    <span class="hljs-keyword">const</span> chromeMetal = <span class="hljs-keyword">new</span> THREE.MeshStandardMaterial({ <span class="hljs-attr">color</span>: <span class="hljs-number">0xcbd5e1</span>, <span class="hljs-attr">metalness</span>: <span class="hljs-number">0.85</span>, <span class="hljs-attr">roughness</span>: <span class="hljs-number">0.22</span> });
    <span class="hljs-keyword">const</span> woodMat = <span class="hljs-keyword">new</span> THREE.MeshStandardMaterial({ <span class="hljs-attr">color</span>: <span class="hljs-number">0x7c4722</span>, <span class="hljs-attr">roughness</span>: <span class="hljs-number">0.65</span> });
